@model IEnumerable<A_New_Hope.Models.Category>

@{
    ViewData["Title"] = "Categories";
}

<div class="page-header">
    <h1>Categories</h1>
</div>

<div class="mb-3">
    <a asp-action="Create" class="btn btn-primary">Create Category</a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(model => model.Name)</th>
                <th>Category Group</th>
                <th>Parent Category</th>
                <th>@Html.DisplayNameFor(model => model.SortOrder)</th>
                <th>@Html.DisplayNameFor(model => model.IsActive)</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => item.Name)</td>
                        <td>@(item.CategoryGroup != null ? item.CategoryGroup.Name : "")</td>
                        <td>@(item.Parent != null ? item.Parent.Name : "-- None --")</td>
                        <td>@Html.DisplayFor(modelItem => item.SortOrder)</td>
                        <td>@Html.DisplayFor(modelItem => item.IsActive)</td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-center text-muted">No categories found.</td>
                </tr>
            }
        </tbody>
    </table>
</div>