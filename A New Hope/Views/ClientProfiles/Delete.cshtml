@model A_New_Hope.Models.ClientProfile

@{
    ViewData["Title"] = "Delete Client Profile";
}

<h1>Delete Client Profile</h1>

<h3>Are you sure you want to delete this?</h3>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">Client</dt>
        <dd class="col-sm-9">
            @(
                        Model.User != null
                        ? $"{Model.User.LastName}, {Model.User.FirstName} ({Model.User.Email})"
                        : ""
                        )
        </dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.EmploymentStatus)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.EmploymentStatus)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.IsUnhoused)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.IsUnhoused)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.UpdatedAt)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.UpdatedAt)</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="UserId" />
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
        </div>
    </form>
</div>