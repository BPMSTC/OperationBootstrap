@{
    ViewData["Title"] = "Home";
}

<div class="container mt-5">
    <div class="main-card">
        <div class="section-header">Workflow Menu</div>

        <p class="mb-4">
            Select a workflow below. Additional workflows and actions can be added here as the project grows.
        </p>

        <div class="row g-4">

            <!-- Clients / Users -->
            <div class="col-md-6 col-lg-4">
                <div class="card workflow-card h-100">
                    <div class="card-body d-flex flex-column">

                        <div class="workflow-title d-flex align-items-center gap-2">
                            
                            @(User.IsInRole("Admin") ? "Users" : "Clients")
                        </div>

                        <p class="workflow-text">
                            Manage and view @(User.IsInRole("Admin") ? "user accounts and roles." : "client records and information.").
                        </p>

                        <a asp-controller="Users"
                               asp-action="Index"
                               class="btn neutral-btn-primary mt-auto">
                             @(User.IsInRole("Admin") ? "Users" : "Clients")
                            <i class="bi bi-people"></i>
                        </a>

                    </div>
                </div>
            </div>

            <!-- Referrals -->
            <div class="col-md-6 col-lg-4">
                <div class="card workflow-card h-100">
                    <div class="card-body d-flex flex-column">

                        <div class="workflow-title d-flex align-items-center gap-2">
                            
                            Referrals
                        </div>

                        <p class="workflow-text">
                            Access referral tools and workflows to manage incoming and outgoing referrals.
                        </p>

                        <a asp-controller="Home"
                               asp-action="ReferralPanel"
                               class="btn neutral-btn-primary mt-auto">
                            
                            <i class="bi bi-arrow-left-right"></i>
                        </a>

                    </div>
                </div>
            </div>

            <!-- Inventory -->
            <div class="col-md-6 col-lg-4">
                <div class="card workflow-card h-100">
                    <div class="card-body d-flex flex-column">

                        <div class="workflow-title d-flex align-items-center gap-2">
                            
                            Inventory
                        </div>

                        <p class="workflow-text">
                            Manage inventory items, categories, and stock levels within the system.
                        </p>

                        <a asp-controller="Home"
                               asp-action="InventoryPanel"
                               class="btn neutral-btn-primary mt-auto">
                            
                            <i class="bi bi-box-seam"></i>
                        </a>

                    </div>
                </div>
            </div>

        </div>
    </div>
</div>