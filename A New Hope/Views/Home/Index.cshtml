@{
    ViewData["Title"] = "Home";
    var users = ViewBag.Users as IEnumerable<dynamic>;
}

<style>
    /* Page background */
    body {
        background-color: #f0f2f5 !important;
        font-family: Arial, sans-serif;
        color: #212529;
    }

    /* Card holding all content */
    .main-card {
        background-color: #e9ecef !important;
        border-radius: 12px;
        padding: 30px;
        box-shadow: 0 6px 20px rgba(0,0,0,0.15); /* slightly stronger shadow */
        border: 2px solid #ced4da; /* slightly thicker border */
    }

    /* Section headers */
    .section-header {
        background-color: #495057 !important;
        color: #ffffff !important;
        padding: 12px 15px;
        border-radius: 8px;
        font-weight: 600;
        font-size: 1.1rem;
        margin-bottom: 15px;
        border: 1px solid #343a40; /* subtle border for clarity */
    }

    /* Buttons */
    .neutral-btn-primary {
        background-color: #343a40 !important;
        border: 2px solid #212529 !important; /* slightly thicker border */
        color: white !important;
        font-weight: 600;
    }

        .neutral-btn-primary:hover {
            background-color: #495057 !important;
        }

    .neutral-btn-secondary {
        background-color: #adb5bd !important;
        border: 2px solid #868e96 !important; /* slightly thicker border */
        color: black !important;
        font-weight: 600;
    }

        .neutral-btn-secondary:hover {
            background-color: #868e96 !important;
            color: white !important;
        }

    /* Scrollable table container */
    .scroll-box {
        max-height: 450px;
        overflow-y: auto;
        background-color: #f8f9fa !important;
        border-radius: 6px;
        padding: 10px;
        border: 2px solid #ced4da; /* makes scroll box easier to see */
    }

    /* Table header */
    table thead {
        background-color: #6c757d !important;
        color: white !important;
    }

    table {
        background-color: #ffffff !important;
        border: 2px solid #ced4da !important; /* stronger table border */
    }

        table th, table td {
            border: 1px solid #adb5bd !important; /* slightly thicker cell borders */
            padding: 8px;
        }

    .clickable-row:hover {
        background-color: #dee2e6 !important;
        cursor: pointer;
    }

    /* Search input */
    #searchInput {
        background-color: #ffffff !important;
        border: 2px solid #ced4da !important; /* thicker border for easy visibility */
        padding: 10px;
    }
</style>

<div class="container mt-5">
    <div class="main-card">

        <!-- Buttons -->
        <div class="d-flex justify-content-between mb-4">
            <a asp-controller="Referrals"
                   asp-action="Create"
                   class="btn neutral-btn-primary btn-lg w-50 me-2">
                + New Referral
            </a>

            <button class="btn neutral-btn-secondary btn-lg w-50 ms-2" disabled>
                Reporting (W.I.P.)
            </button>
        </div>

        <!-- Client List Section -->
        <div class="section-header mb-3">
            Client List
        </div>

        <!-- Search Input -->
        <input type="text"
               id="searchInput"
               class="form-control form-control-lg mb-3"
               placeholder="Search by name, email, or address..." />

        <!-- Scrollable Table -->
        <div class="scroll-box">
            <table class="table table-hover table-bordered mb-0">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Address</th>
                    </tr>
                </thead>
                <tbody id="resultsBody">
                    @if (users != null)
                    {
                        foreach (var user in users)
                        {
                            <tr class="clickable-row" data-id="@user.Id">
                                <td>@user.FullName</td>
                                <td>@user.Email</td>
                                <td>@user.Address</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const input = document.getElementById("searchInput");
        const resultsBody = document.getElementById("resultsBody");

        // Live search
        input.addEventListener("input", function () {
            const query = input.value;

            // If empty, reload full list
            if (query.length === 0) {
                fetch(`/Home/Index`)
                    .then(() => location.reload());
                return;
            }

            fetch(`/Home/Search?query=${encodeURIComponent(query)}`)
                .then(response => response.json())
                .then(data => {
                    resultsBody.innerHTML = "";

                    if (data.length === 0) {
                        resultsBody.innerHTML =
                            `<tr><td colspan="3" class="text-center">No results found</td></tr>`;
                        return;
                    }

                    data.forEach(user => {
                        const row = `
                            <tr class="clickable-row" data-id="${user.id}">
                                <td>${user.fullName}</td>
                                <td>${user.email}</td>
                                <td>${user.address}</td>
                            </tr>
                        `;
                        resultsBody.innerHTML += row;
                    });
                });
        });

        // Clickable rows
        document.addEventListener("click", function (e) {
            const row = e.target.closest(".clickable-row");
            if (row) {
                const id = row.getAttribute("data-id");
                window.location.href = `/ClientProfiles/Details/${id}`;
            }
        });
    </script>
}