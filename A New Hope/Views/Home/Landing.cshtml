<div class="container landing-wrapper">
    <div class="landing-shell">
        <div class="landing-panel">

            <div class="brand-logo">
                <img src="~/images/logo_Operation-Bootstrap-tagline.svg"
                     alt="Operation Bootstrap Logo" />
            </div>

            <div class="landing-card">
                <h1 class="landing-title">Welcome</h1>

                <p class="landing-description">
                    Operation Bootstrap provides a centralized system for managing client records,
                    referrals, preferences, and inventory-related workflows.
                    Please sign in with your authorized staff or administrator account to continue.
                </p>

                <a class="btn btn-signin btn-lg" href="/Account/Login">
                    Sign In
                </a>
            </div>

        </div>
    </div>
</div>