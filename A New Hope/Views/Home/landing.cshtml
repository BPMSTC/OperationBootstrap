@model A_New_Hope.ViewModel.LoginViewModel

@{
    ViewData["Title"] = "Welcome";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            min-height: 100vh;
            background-color: #f5f7fb;
            font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        }

        .page-container {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .login-wrapper {
            width: 100%;
            max-width: 420px;
            text-align: center;
        }

        .brand-logo {
            margin-bottom: 2rem;
        }

            .brand-logo img {
                width: 100%;
                height: auto;
            }

        .login-card {
            padding: 2.5rem;
            background: white;
            border-radius: 12px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
            text-align: left;
        }

        .form-control {
            padding: 0.75rem;
        }

        .login-footer {
            font-size: 0.9rem;
            color: #6b7280;
            text-align: center;
        }
    </style>
</head>

<body>

    <div class="page-container">
        <div class="login-wrapper">

            <!-- LOGO / HERO -->
            <div class="brand-logo">
                <img src="~/images/logo_Operation-Bootstrap-tagline.svg"
                     alt="Operation Bootstrap Logo" />
            </div>

            <!-- LOGIN CARD -->
            <div class="login-card">

                <h2 class="fw-bold mb-3 text-center">Welcome Back</h2>
                <p class="text-muted text-center mb-4">
                    Please sign in to continue
                </p>

                <form asp-controller="Account" asp-action="Login" method="post" novalidate>
                    @Html.AntiForgeryToken()

                    <!-- Validation Summary -->
                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger mb-3"
                         role="alert">
                    </div>

                    <!-- Return URL -->
                    <input type="hidden" asp-for="ReturnUrl" />

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email"
                               class="form-control"
                               placeholder="you@example.com" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password"
                               class="form-control"
                               placeholder="••••••••" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="form-check mb-4">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label"></label>
                    </div>

                    <div class="d-grid mb-3">
                        <button type="submit" class="btn btn-primary btn-lg">
                            Log In
                        </button>
                    </div>

                    <div class="login-footer">
                        <a asp-controller="Account" asp-action="ForgotPassword">
                            Forgot your password?
                        </a>
                        <br />
                        <span>
                            Don’t have an account?
                            <a asp-controller="Account" asp-action="Register">
                                Sign up
                            </a>
                        </span>
                    </div>

                </form>
            </div>

        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }

</body>
</html>