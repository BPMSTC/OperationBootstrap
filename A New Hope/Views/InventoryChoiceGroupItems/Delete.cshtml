@model A_New_Hope.Models.InventoryChoiceGroupItem

@{
    ViewData["Title"] = "Delete Inventory Choice Group Item";
}

<h1>Delete Inventory Choice Group Item</h1>

<h3>Are you sure you want to delete this group item?</h3>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">Choice Group</dt>
        <dd class="col-sm-9">
            @(
                Model.InventoryChoiceGroup != null
                ? (!string.IsNullOrWhiteSpace(Model.InventoryChoiceGroup.DisplayLabel)
                    ? Model.InventoryChoiceGroup.DisplayLabel
                    : Model.InventoryChoiceGroup.Name)
                : ""
            )
        </dd>

        <dt class="col-sm-3">Inventory Item</dt>
        <dd class="col-sm-9">@(Model.InventoryItem?.Name ?? "")</dd>

        <dt class="col-sm-3">Category</dt>
        <dd class="col-sm-9">
            @(
                Model.InventoryItem?.Category != null
                ? (Model.InventoryItem.Category.CategoryGroup != null
                    ? $"{Model.InventoryItem.Category.CategoryGroup.Name} - {Model.InventoryItem.Category.Name}"
                    : Model.InventoryItem.Category.Name)
                : ""
            )
        </dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.IsActive)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.IsActive)</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Delete" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-outline-secondary ms-1">Back to List</a>
    </form>
</div>