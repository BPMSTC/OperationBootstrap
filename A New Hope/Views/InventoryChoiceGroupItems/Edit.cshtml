@model A_New_Hope.Models.InventoryChoiceGroupItem

@{
    ViewData["Title"] = "Edit Inventory Choice Group Item";
}

<div class="page-header">
    <h1>Edit Inventory Choice Group Item</h1>
</div>

<hr />

<div class="row">
    <div class="col-md-6 col-lg-5">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label asp-for="InventoryChoiceGroupId" class="form-label"></label>
                <select asp-for="InventoryChoiceGroupId" class="form-select" asp-items="ViewBag.InventoryChoiceGroupId">
                    <option value="">-- Select Choice Group --</option>
                </select>
                <span asp-validation-for="InventoryChoiceGroupId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="InventoryItemId" class="form-label"></label>
                <select asp-for="InventoryItemId" class="form-select" asp-items="ViewBag.InventoryItemId">
                    <option value="">-- Select Inventory Item --</option>
                </select>
                <span asp-validation-for="InventoryItemId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="SortOrder" class="form-label"></label>
                <input asp-for="SortOrder" class="form-control" />
                <span asp-validation-for="SortOrder" class="text-danger"></span>
            </div>

            <div class="form-check mb-3">
                <input class="form-check-input" asp-for="IsActive" />
                <label class="form-check-label" asp-for="IsActive"></label>
            </div>

            <div>
                <input type="submit" value="Save" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-outline-secondary ms-1">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}