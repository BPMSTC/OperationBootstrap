@model A_New_Hope.Models.InventoryItem

@{
    ViewData["Title"] = "Inventory Item Details";
}

<h1>Inventory Item Details</h1>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Name)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Name)</dd>

        <dt class="col-sm-3">Category</dt>
        <dd class="col-sm-9">
            @(
                        Model.Category != null
                        ? (Model.Category.CategoryGroup != null
                        ? $"{Model.Category.CategoryGroup.Name} - {Model.Category.Name}"
                        : Model.Category.Name)
                        : ""
                        )
        </dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.IsBaseline)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.IsBaseline)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.IsAvailable)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.IsAvailable)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.IsActive)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.IsActive)</dd>

        <dt class="col-sm-3">Options</dt>
        <dd class="col-sm-9">
            @if (Model.InventoryItemOptions != null && Model.InventoryItemOptions.Any())
            {
                <ul class="mb-0">
                    @foreach (var option in Model.InventoryItemOptions.OrderBy(o => o.SortOrder).ThenBy(o => o.Name))
                    {
                        <li>@option.Name</li>
                    }
                </ul>
            }
            else
            {
                <span class="text-muted">No options for this item.</span>
            }
        </dd>
    </dl>
</div>

<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary">Edit</a>
    <a asp-action="Index" class="btn btn-outline-secondary ms-1">Back to List</a>
</div>