@model IEnumerable<A_New_Hope.Models.InventoryItem>

@{
    ViewData["Title"] = "Inventory Items";
}

<h1>Inventory Items</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New</a>
</p>

<table class="table table-striped table-hover align-middle">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Name)</th>
            <th>Category</th>
            <th>@Html.DisplayNameFor(model => model.IsBaseline)</th>
            <th>@Html.DisplayNameFor(model => model.IsAvailable)</th>
            <th>@Html.DisplayNameFor(model => model.IsActive)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model)
{
        <tr>
            <td>@Html.DisplayFor(modelItem => item.Name)</td>
            <td>
                @(
                    item.Category != null
                        ? (item.Category.CategoryGroup != null
                            ? $"{item.Category.CategoryGroup.Name} - {item.Category.Name}"
                            : item.Category.Name)
                        : ""
                )
            </td>
            <td>@Html.DisplayFor(modelItem => item.IsBaseline)</td>
            <td>@Html.DisplayFor(modelItem => item.IsAvailable)</td>
            <td>@Html.DisplayFor(modelItem => item.IsActive)</td>
            <td class="text-nowrap">
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>