@model A_New_Hope.Models.Referral

@{
    ViewData["Title"] = "Delete Referral";
}

<h1 class="mb-3">Delete Referral</h1>
<hr />

<form asp-action="Delete" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <p class="text-muted mb-4">
        This will permanently delete this referral.
    </p>

    <!-- ================= BASIC INFO ================= -->
    <section class="mb-4">
        <h5 class="mb-3">Basic Information</h5>

        <dl class="row">

            @if (Model.ClientUser != null)
            {
                <dt class="col-sm-3">Client</dt>
                <dd class="col-sm-9">
                    @($"{Model.ClientUser.LastName}, {Model.ClientUser.FirstName} ({Model.ClientUser.Email})")
                </dd>
            }

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">@Model.Status</dd>

            <dt class="col-sm-3">Referred On</dt>
            <dd class="col-sm-9">@Model.ReferredOn.ToString("MM/dd/yyyy")</dd>

            @if (Model.ValidFrom != null)
            {
                <dt class="col-sm-3">Valid From</dt>
                <dd class="col-sm-9">@Model.ValidFrom?.ToString("MM/dd/yyyy")</dd>
            }

            @if (Model.ValidTo != null)
            {
                <dt class="col-sm-3">Valid To</dt>
                <dd class="col-sm-9">@Model.ValidTo?.ToString("MM/dd/yyyy")</dd>
            }

        </dl>
    </section>

    <!-- ================= REFERRING ORGANIZATION ================= -->
    @if (Model.ReferringOrganization != null)
    {
        <section class="mb-4">
            <h5 class="mb-3">Referring Organization</h5>

            <dl class="row">

                @if (!string.IsNullOrWhiteSpace(Model.ReferringOrganization.Name))
                {
                    <dt class="col-sm-3">Organization Name</dt>
                    <dd class="col-sm-9">@Model.ReferringOrganization.Name</dd>
                }

                @if (!string.IsNullOrWhiteSpace(Model.ReferringOrganization.PrimaryContactName))
                {
                    <dt class="col-sm-3">Contact Name</dt>
                    <dd class="col-sm-9">@Model.ReferringOrganization.PrimaryContactName</dd>
                }

                @if (!string.IsNullOrWhiteSpace(Model.ReferringOrganization.PhoneNumber))
                {
                    <dt class="col-sm-3">Phone</dt>
                    <dd class="col-sm-9">@Model.ReferringOrganization.PhoneNumber</dd>
                }

                @if (!string.IsNullOrWhiteSpace(Model.ReferringOrganization.Email))
                {
                    <dt class="col-sm-3">Email</dt>
                    <dd class="col-sm-9">@Model.ReferringOrganization.Email</dd>
                }

            </dl>
        </section>
    }

    <!-- ================= NOTES ================= -->
    @if (!string.IsNullOrWhiteSpace(Model.Notes))
    {
        <section class="mb-4">
            <h5 class="mb-3">Notes</h5>

            <div class="border rounded p-3">
                @Model.Notes
            </div>
        </section>
    }

    @* <!-- ================= SYSTEM INFO ================= -->
    @if (Model.CreatedAt != null || Model.UpdatedAt != null)
    {
        <section class="mb-4">
            <h5 class="mb-3">System Information</h5>

            <dl class="row">

                @if (Model.CreatedAt != null)
                {
                    <dt class="col-sm-3">Created</dt>
                    <dd class="col-sm-9">@Model.CreatedAt</dd>
                }

                @if (Model.UpdatedAt != null)
                {
                    <dt class="col-sm-3">Updated</dt>
                    <dd class="col-sm-9">@Model.UpdatedAt</dd>
                }

            </dl>
        </section>
    } *@

    <!-- ================= ACTIONS ================= -->
    <div class="mt-3">
        <button type="submit" class="btn btn-danger">
            Delete
        </button>

        <a asp-action="Index" class="btn btn-outline-secondary ms-2">
            Cancel
        </a>
    </div>

</form>