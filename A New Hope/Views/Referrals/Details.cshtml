@model A_New_Hope.Models.Referral

@{
    ViewData["Title"] = "Referral Details";
}

<h1>Referral Details</h1>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />

    <div>
        <hr />
        <dl class="row">

            <!-- Client -->
            <dt class="col-sm-3">Client</dt>
            <dd class="col-sm-9">
                <span class="view-mode">
                    @(
                        Model.ClientUser != null
                        ? $"{Model.ClientUser.LastName}, {Model.ClientUser.FirstName} ({Model.ClientUser.Email})"
                        : ""
                    )
                </span>

                <select class="form-control edit-mode d-none"
                        asp-for="ClientUserId"
                        asp-items="ViewBag.Clients">
                </select>
            </dd>

            <!-- Referring Organization -->
            <dt class="col-sm-3">Referring Organization</dt>
            <dd class="col-sm-9">
                <span class="view-mode">
                    @Model.ReferringOrganization?.Name
                </span>

                <select class="form-control edit-mode d-none"
                        asp-for="ReferringOrganizationId"
                        asp-items="ViewBag.Organizations">
                </select>
            </dd>

            <!-- Referred On -->
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.ReferredOn)</dt>
            <dd class="col-sm-9">
                <span class="view-mode">@Html.DisplayFor(model => model.ReferredOn)</span>
                <input class="form-control edit-mode d-none" asp-for="ReferredOn" />
            </dd>

            <!-- Status -->
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Status)</dt>
            <dd class="col-sm-9">
                <span class="view-mode">@Html.DisplayFor(model => model.Status)</span>
                <input class="form-control edit-mode d-none" asp-for="Status" />
            </dd>

            <!-- Valid From -->
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.ValidFrom)</dt>
            <dd class="col-sm-9">
                <span class="view-mode">@Html.DisplayFor(model => model.ValidFrom)</span>
                <input class="form-control edit-mode d-none" asp-for="ValidFrom" />
            </dd>

            <!-- Valid To -->
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.ValidTo)</dt>
            <dd class="col-sm-9">
                <span class="view-mode">@Html.DisplayFor(model => model.ValidTo)</span>
                <input class="form-control edit-mode d-none" asp-for="ValidTo" />
            </dd>

            <!-- Referrer Info (still display-only)  we said these will likely be changed-->
            <dt class="col-sm-3">Referrer Name</dt>
            <dd class="col-sm-9">@Model.ReferringOrganization?.PrimaryContactName</dd>

            <dt class="col-sm-3">Referrer Phone</dt>
            <dd class="col-sm-9">@Model.ReferringOrganization?.PhoneNumber</dd>

            <dt class="col-sm-3">Referrer Email</dt>
            <dd class="col-sm-9">@Model.ReferringOrganization?.Email</dd>

            <!-- Notes -->
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Notes)</dt>
            <dd class="col-sm-9">
                <span class="view-mode">@Html.DisplayFor(model => model.Notes)</span>
                <textarea class="form-control edit-mode d-none" asp-for="Notes"></textarea>
            </dd>

            <!-- Created / Updated -->
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.CreatedAt)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.CreatedAt)</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.UpdatedAt)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.UpdatedAt)</dd>

        </dl>
    </div>

    <!-- Buttons -->
    <div class="d-flex justify-content-end gap-2">
        <button type="button" id="editBtn" class="btn btn-primary">
            <i class="bi bi-pencil"></i> Edit
        </button>

        <button type="submit" id="saveBtn" class="btn btn-success d-none">
            <i class="bi bi-save"></i> Save
        </button>

        <button type="button" id="cancelBtn" class="btn btn-secondary d-none">
            Cancel
        </button>

        <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
    </div>
</form>

@section Scripts {
    <script>
        const editBtn = document.getElementById("editBtn");
        const saveBtn = document.getElementById("saveBtn");
        const cancelBtn = document.getElementById("cancelBtn");

        const viewMode = document.querySelectorAll(".view-mode");
        const editMode = document.querySelectorAll(".edit-mode");

        editBtn.addEventListener("click", () => {
            viewMode.forEach(el => el.classList.add("d-none"));
            editMode.forEach(el => el.classList.remove("d-none"));

            editBtn.classList.add("d-none");
            saveBtn.classList.remove("d-none");
            cancelBtn.classList.remove("d-none");
        });

        cancelBtn.addEventListener("click", () => {
            location.reload();
        });
    </script>
}