@model A_New_Hope.Models.Referral

@{
    ViewData["Title"] = "Referral Details";
}

<h1>Referral Details</h1>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">Client</dt>
        <dd class="col-sm-9">
            @(
                Model.ClientUser != null
                    ? $"{Model.ClientUser.LastName}, {Model.ClientUser.FirstName} ({Model.ClientUser.Email})"
                    : ""
            )
        </dd>

        <dt class="col-sm-3">Referring Organization</dt>
        <dd class="col-sm-9">
            @(
                Model.ReferringOrganization != null
                    ? Model.ReferringOrganization.Name
                    : ""
            )
        </dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.ReferredOn)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.ReferredOn)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Status)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Status)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.ValidFrom)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.ValidFrom)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.ValidTo)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.ValidTo)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.ReferredByName)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.ReferredByName)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.ReferredByPhoneNumber)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.ReferredByPhoneNumber)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.ReferredByEmail)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.ReferredByEmail)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Notes)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Notes)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.CreatedAt)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.CreatedAt)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.UpdatedAt)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.UpdatedAt)</dd>
    </dl>
</div>

<div>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
    <a asp-action="Index" class="btn btn-outline-secondary ms-1">Back to List</a>
</div>