@model IEnumerable<A_New_Hope.Models.Referral>

@{
    ViewData["Title"] = "Referrals";
}

<div class="page-header">
    <h1>Referrals</h1>
</div>

<div class="mb-3 d-flex justify-content-between align-items-center">
    <a asp-action="Create" class="btn btn-primary">Create New</a>
    <input type="text" id="searchInput" class="form-control w-auto" placeholder="Search referrals..." />
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle referrals-table" id="referralsTable">
        <thead>
            <tr>
                <th>Client</th>
                <th>Referring Organization</th>
                <th>@Html.DisplayNameFor(model => model.ReferredOn)</th>
                <th>@Html.DisplayNameFor(model => model.Status)</th>
                <th>@Html.DisplayNameFor(model => model.ValidTo)</th>
                <th>@Html.DisplayNameFor(model => model.ReferredByName)</th>
                <th>@Html.DisplayNameFor(model => model.UpdatedAt)</th>
                <th class="text-end text-nowrap">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @(
                                item.ClientUser != null
                                    ? $"{item.ClientUser.LastName}, {item.ClientUser.FirstName} ({item.ClientUser.Email})"
                                    : ""
                            )
                        </td>
                        <td>@(item.ReferringOrganization != null ? item.ReferringOrganization.Name : "")</td>
                        <td>@Html.DisplayFor(modelItem => item.ReferredOn)</td>
                        <td>@Html.DisplayFor(modelItem => item.Status)</td>
                        <td>@Html.DisplayFor(modelItem => item.ValidTo)</td>
                        <td>@Html.DisplayFor(modelItem => item.ReferredByName)</td>
                        <td>@Html.DisplayFor(modelItem => item.UpdatedAt)</td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="8" class="text-center text-muted">No referrals found.</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        const searchInput = document.getElementById('searchInput');
        const tableRows = document.querySelectorAll('#referralsTable tbody tr');

        searchInput.addEventListener('input', function () {
            const query = this.value.toLowerCase();

            tableRows.forEach(row => {
                // Check all row text (Client, Org, Referrer, etc.)
                const rowText = row.innerText.toLowerCase();
                row.style.display = rowText.includes(query) ? '' : 'none';
            });
        });
    </script>
}