@model IEnumerable<A_New_Hope.Models.Referral>
@using A_New_Hope.Models

@{
    ViewData["Title"] = "Referrals";

    var currentSearchTerm = ViewData["CurrentSearchTerm"] as string;
    var currentStatusFilter = ViewData["CurrentStatusFilter"] as string;
    var currentSortOrder = ViewData["CurrentSortOrder"] as string;
    var currentReferredOnFrom = ViewData["CurrentReferredOnFrom"] as string;
    var currentReferredOnTo = ViewData["CurrentReferredOnTo"] as string;

    string nextDateSort = string.IsNullOrWhiteSpace(currentSortOrder) || currentSortOrder == "date_desc"
        ? "date_asc"
        : "date_desc";

    string nextClientSort = currentSortOrder == "client_asc" ? "client_desc"
        : currentSortOrder == "client_desc" ? "client_asc"
        : "client_asc";

    string nextOrganizationSort = currentSortOrder == "organization_asc" ? "organization_desc"
        : currentSortOrder == "organization_desc" ? "organization_asc"
        : "organization_asc";

    string nextStatusSort = currentSortOrder == "status_asc" ? "status_desc"
        : currentSortOrder == "status_desc" ? "status_asc"
        : "status_asc";

    string dateIndicator = currentSortOrder == "date_asc" ? "↑"
        : currentSortOrder == "date_desc" || string.IsNullOrWhiteSpace(currentSortOrder) ? "↓"
        : "";

    string clientIndicator = currentSortOrder == "client_asc" ? "↑"
        : currentSortOrder == "client_desc" ? "↓"
        : "";

    string organizationIndicator = currentSortOrder == "organization_asc" ? "↑"
        : currentSortOrder == "organization_desc" ? "↓"
        : "";

    string statusIndicator = currentSortOrder == "status_asc" ? "↑"
        : currentSortOrder == "status_desc" ? "↓"
        : "";
}

<div class="page-header referrals-header d-flex justify-content-between align-items-center flex-wrap gap-3">
    <h1 class="mb-0">Referrals</h1>

    <a asp-action="StartReferralEntry" class="btn btn-primary">
        Create New
    </a>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger mb-4">
        @TempData["ErrorMessage"]
    </div>
}

<div class="card shadow-sm mb-4 referrals-search-card">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-2 align-items-end">
            <div class="col-12 col-xl-4">
                <label for="searchTerm" class="form-label">Search referrals</label>
                <div class="input-group">
                    <span class="input-group-text" aria-hidden="true">🔍</span>
                    <input type="text"
                           id="searchTerm"
                           name="searchTerm"
                           value="@currentSearchTerm"
                           class="form-control"
                           placeholder="Client or organization" />
                </div>
            </div>

            <div class="col-6 col-md-3 col-xl-2">
                <label for="statusFilter" class="form-label">Status</label>
                <select id="statusFilter" name="statusFilter" class="form-select">
                    @if (string.IsNullOrWhiteSpace(currentStatusFilter))
                    {
                        <option value="" selected>All statuses</option>
                    }
                    else
                    {
                        <option value="">All statuses</option>
                    }

                    @foreach (ReferralStatus status in Enum.GetValues(typeof(ReferralStatus)))
                    {
                        var statusValue = status.ToString();

                        if (statusValue == currentStatusFilter)
                        {
                            <option value="@statusValue" selected>@statusValue</option>
                        }
                        else
                        {
                            <option value="@statusValue">@statusValue</option>
                        }
                    }
                </select>
            </div>

            <div class="col-6 col-md-3 col-xl-2">
                <label for="referredOnFrom" class="form-label">From</label>
                <input type="date"
                       id="referredOnFrom"
                       name="referredOnFrom"
                       value="@currentReferredOnFrom"
                       class="form-control" />
            </div>

            <div class="col-6 col-md-3 col-xl-2">
                <label for="referredOnTo" class="form-label">To</label>
                <input type="date"
                       id="referredOnTo"
                       name="referredOnTo"
                       value="@currentReferredOnTo"
                       class="form-control" />
            </div>

            <div class="col-6 col-md-3 col-xl-2">
                <div class="d-flex gap-2 referrals-search-actions">
                    <button type="submit" class="btn btn-primary w-100">
                        Search
                    </button>

                    <a asp-action="Index" class="btn btn-outline-secondary">
                        Reset
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle referrals-table">
        <thead>
            <tr>
                <th>
                    <a asp-action="Index"
                       asp-route-searchTerm="@currentSearchTerm"
                       asp-route-statusFilter="@currentStatusFilter"
                       asp-route-referredOnFrom="@currentReferredOnFrom"
                       asp-route-referredOnTo="@currentReferredOnTo"
                       asp-route-sortOrder="@nextClientSort"
                       class="sort-header-link">
                        <span>Client</span>
                        @if (!string.IsNullOrWhiteSpace(clientIndicator))
                        {
                            <span class="sort-indicator">@clientIndicator</span>
                        }
                    </a>
                </th>

                <th>
                    <a asp-action="Index"
                       asp-route-searchTerm="@currentSearchTerm"
                       asp-route-statusFilter="@currentStatusFilter"
                       asp-route-referredOnFrom="@currentReferredOnFrom"
                       asp-route-referredOnTo="@currentReferredOnTo"
                       asp-route-sortOrder="@nextOrganizationSort"
                       class="sort-header-link">
                        <span>Referring Organization</span>
                        @if (!string.IsNullOrWhiteSpace(organizationIndicator))
                        {
                            <span class="sort-indicator">@organizationIndicator</span>
                        }
                    </a>
                </th>

                <th>
                    <a asp-action="Index"
                       asp-route-searchTerm="@currentSearchTerm"
                       asp-route-statusFilter="@currentStatusFilter"
                       asp-route-referredOnFrom="@currentReferredOnFrom"
                       asp-route-referredOnTo="@currentReferredOnTo"
                       asp-route-sortOrder="@nextDateSort"
                       class="sort-header-link">
                        <span>Referral Date</span>
                        @if (!string.IsNullOrWhiteSpace(dateIndicator))
                        {
                            <span class="sort-indicator">@dateIndicator</span>
                        }
                    </a>
                </th>

                <th>
                    <a asp-action="Index"
                       asp-route-searchTerm="@currentSearchTerm"
                       asp-route-statusFilter="@currentStatusFilter"
                       asp-route-referredOnFrom="@currentReferredOnFrom"
                       asp-route-referredOnTo="@currentReferredOnTo"
                       asp-route-sortOrder="@nextStatusSort"
                       class="sort-header-link">
                        <span>Status</span>
                        @if (!string.IsNullOrWhiteSpace(statusIndicator))
                        {
                            <span class="sort-indicator">@statusIndicator</span>
                        }
                    </a>
                </th>

                <th class="text-end text-nowrap">Actions</th>
            </tr>
        </thead>

        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @if (item.ClientUser != null)
                            {
                                <a asp-controller="Users"
                                   asp-action="Details"
                                   asp-route-id="@item.ClientUserId">
                                    @item.ClientUser.FirstName @item.ClientUser.LastName
                                </a>
                            }
                            else
                            {
                                <span class="text-muted">No client assigned</span>
                            }
                        </td>

                        <td>
                            @if (item.ReferringOrganization != null)
                            {
                                <a asp-controller="ReferringOrganizations"
                                   asp-action="Details"
                                   asp-route-id="@item.ReferringOrganizationId">
                                    @item.ReferringOrganization.Name
                                </a>
                            }
                            else
                            {
                                <span class="text-muted">No organization assigned</span>
                            }
                        </td>

                        <td>
                            @item.ReferredOn.ToString("MM/dd/yyyy")
                        </td>

                        <td>
                            <span class="badge bg-secondary">
                                @item.Status
                            </span>
                        </td>

                        <td class="text-end text-nowrap">
                            <a asp-action="Details"
                               asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-secondary">
                                Details
                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-danger">
                                Delete
                            </a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-center text-muted">
                        No referrals found.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>