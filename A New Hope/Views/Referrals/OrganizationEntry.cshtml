@model A_New_Hope.Models.ViewModels.Referrals.OrganizationEntryViewModel

@{
    ViewData["Title"] = "Referring Organization";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-xl-8 col-lg-10">

            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <div class="mb-4">
                        <h2 class="mb-1">Referring Organization</h2>
                        <p class="text-muted mb-0">
                            Select an existing referring organization or enter a new one.
                        </p>
                    </div>

                    <form asp-action="OrganizationEntry" method="post" novalidate>
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <!-- Existing Organization -->
                        <div class="card border-0 bg-light mb-4">
                            <div class="card-body">
                                <h5 class="card-title mb-3">Use Existing Organization</h5>

                                <div class="mb-3">
                                    <label asp-for="SelectedReferringOrganizationId" class="form-label"></label>
                                    <select asp-for="SelectedReferringOrganizationId"
                                            asp-items="Model.ExistingOrganizations"
                                            class="form-select"
                                            id="existingOrganizationSelect">
                                        <option value="">-- Select an organization --</option>
                                    </select>
                                    <span asp-validation-for="SelectedReferringOrganizationId" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="text-center text-muted fw-semibold my-3">OR</div>

                        <!-- New Organization -->
                        <div class="card border-0 bg-light mb-4" id="newOrganizationCard">
                            <div class="card-body">
                                <h5 class="card-title mb-3">Enter New Organization</h5>

                                <div class="row g-3">
                                    <div class="col-md-12">
                                        <label asp-for="NewOrganization.Name" class="form-label"></label>
                                        <input asp-for="NewOrganization.Name" class="form-control new-org-field" />
                                        <span asp-validation-for="NewOrganization.Name" class="text-danger"></span>
                                    </div>

                                    <div class="col-md-6">
                                        <label asp-for="NewOrganization.Type" class="form-label"></label>
                                        <input asp-for="NewOrganization.Type" class="form-control new-org-field" />
                                        <span asp-validation-for="NewOrganization.Type" class="text-danger"></span>
                                    </div>

                                    <div class="col-md-6">
                                        <label asp-for="NewOrganization.PrimaryContactName" class="form-label"></label>
                                        <input asp-for="NewOrganization.PrimaryContactName" class="form-control new-org-field" />
                                        <span asp-validation-for="NewOrganization.PrimaryContactName" class="text-danger"></span>
                                    </div>

                                    <div class="col-md-6">
                                        <label asp-for="NewOrganization.Email" class="form-label"></label>
                                        <input asp-for="NewOrganization.Email" class="form-control new-org-field" />
                                        <span asp-validation-for="NewOrganization.Email" class="text-danger"></span>
                                    </div>

                                    <div class="col-md-6">
                                        <label asp-for="NewOrganization.PhoneNumber" class="form-label"></label>
                                        <input asp-for="NewOrganization.PhoneNumber" class="form-control new-org-field" />
                                        <span asp-validation-for="NewOrganization.PhoneNumber" class="text-danger"></span>
                                    </div>

                                    <div class="col-md-12">
                                        <label asp-for="NewOrganization.AddressLine1" class="form-label"></label>
                                        <input asp-for="NewOrganization.AddressLine1" class="form-control new-org-field" />
                                        <span asp-validation-for="NewOrganization.AddressLine1" class="text-danger"></span>
                                    </div>

                                    <div class="col-md-12">
                                        <label asp-for="NewOrganization.AddressLine2" class="form-label"></label>
                                        <input asp-for="NewOrganization.AddressLine2" class="form-control new-org-field" />
                                        <span asp-validation-for="NewOrganization.AddressLine2" class="text-danger"></span>
                                    </div>

                                    <div class="col-md-5">
                                        <label asp-for="NewOrganization.City" class="form-label"></label>
                                        <input asp-for="NewOrganization.City" class="form-control new-org-field" />
                                        <span asp-validation-for="NewOrganization.City" class="text-danger"></span>
                                    </div>

                                    <div class="col-md-3">
                                        <label asp-for="NewOrganization.State" class="form-label"></label>
                                        <input asp-for="NewOrganization.State" class="form-control new-org-field" maxlength="2" />
                                        <span asp-validation-for="NewOrganization.State" class="text-danger"></span>
                                    </div>

                                    <div class="col-md-4">
                                        <label asp-for="NewOrganization.PostalCode" class="form-label"></label>
                                        <input asp-for="NewOrganization.PostalCode" class="form-control new-org-field" />
                                        <span asp-validation-for="NewOrganization.PostalCode" class="text-danger"></span>
                                    </div>

                                    <div class="col-md-12">
                                        <label asp-for="NewOrganization.Notes" class="form-label"></label>
                                        <textarea asp-for="NewOrganization.Notes" class="form-control new-org-field" rows="4"></textarea>
                                        <span asp-validation-for="NewOrganization.Notes" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between pt-2">
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                            <button type="submit" class="btn btn-primary">Next: Client</button>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        (function () {
            const existingSelect = document.getElementById("existingOrganizationSelect");
            const newFields = document.querySelectorAll(".new-org-field");

            function hasNewOrganizationInput() {
                for (const field of newFields) {
                    if (field.type === "checkbox") {
                        if (field.checked) return true;
                    } else if (field.value && field.value.trim() !== "") {
                        return true;
                    }
                }
                return false;
            }

            function toggleNewFieldsFromExistingSelection() {
                const hasExistingSelection = existingSelect && existingSelect.value !== "";

                newFields.forEach(field => {
                    field.disabled = hasExistingSelection;
                });
            }

            function toggleExistingSelectFromNewInput() {
                const hasNewInput = hasNewOrganizationInput();

                if (existingSelect) {
                    existingSelect.disabled = hasNewInput;

                    if (hasNewInput) {
                        existingSelect.value = "";
                    }
                }
            }

            if (existingSelect) {
                existingSelect.addEventListener("change", function () {
                    toggleNewFieldsFromExistingSelection();
                });
            }

            newFields.forEach(field => {
                field.addEventListener("input", function () {
                    toggleExistingSelectFromNewInput();
                    toggleNewFieldsFromExistingSelection();
                });

                field.addEventListener("change", function () {
                    toggleExistingSelectFromNewInput();
                    toggleNewFieldsFromExistingSelection();
                });
            });

            toggleExistingSelectFromNewInput();
            toggleNewFieldsFromExistingSelection();
        })();
    </script>
}