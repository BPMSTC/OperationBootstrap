@model A_New_Hope.Models.ReferringOrganization

@{
    ViewData["Title"] = "Delete Referring Organization";
}

<h1 class="mb-3">Delete Referring Organization</h1>
<hr />

<form asp-action="Delete" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <p class="text-muted mb-4">
        This action will permanently delete this organization.
    </p>

    <!-- ================= BASIC INFO ================= -->
    <section class="mb-4">
        <h5 class="mb-3">Basic Information</h5>

        <dl class="row">

            @if (!string.IsNullOrWhiteSpace(Model.Name))
            {
                <dt class="col-sm-3">Name</dt>
                <dd class="col-sm-9">@Model.Name</dd>
            }

            @if (Model.Type != null)
            {
                <dt class="col-sm-3">Type</dt>
                <dd class="col-sm-9">@Model.Type</dd>
            }

            @if (!string.IsNullOrWhiteSpace(Model.PrimaryContactName))
            {
                <dt class="col-sm-3">Primary Contact</dt>
                <dd class="col-sm-9">@Model.PrimaryContactName</dd>
            }

        </dl>
    </section>

    <!-- ================= CONTACT INFO ================= -->
    @if (!string.IsNullOrWhiteSpace(Model.PhoneNumber) ||
         !string.IsNullOrWhiteSpace(Model.Email))
    {
        <section class="mb-4">
            <h5 class="mb-3">Contact Information</h5>

            <dl class="row">

                @if (!string.IsNullOrWhiteSpace(Model.PhoneNumber))
                {
                    <dt class="col-sm-3">Phone</dt>
                    <dd class="col-sm-9">@Model.PhoneNumber</dd>
                }

                @if (!string.IsNullOrWhiteSpace(Model.Email))
                {
                    <dt class="col-sm-3">Email</dt>
                    <dd class="col-sm-9">@Model.Email</dd>
                }

            </dl>
        </section>
    }

    <!-- ================= LOCATION ================= -->
    @if (!string.IsNullOrWhiteSpace(Model.City) ||
         !string.IsNullOrWhiteSpace(Model.State))
    {
        <section class="mb-4">
            <h5 class="mb-3">Location</h5>

            <dl class="row">

                @if (!string.IsNullOrWhiteSpace(Model.City))
                {
                    <dt class="col-sm-3">City</dt>
                    <dd class="col-sm-9">@Model.City</dd>
                }

                @if (!string.IsNullOrWhiteSpace(Model.State))
                {
                    <dt class="col-sm-3">State</dt>
                    <dd class="col-sm-9">@Model.State</dd>
                }

            </dl>
        </section>
    }

    @* <!-- ================= SYSTEM INFO ================= -->
    <section class="mb-4">
        <h5 class="mb-3">System Information</h5>

        <dl class="row">

            <dt class="col-sm-3">Active</dt>
            <dd class="col-sm-9">@Model.IsActive</dd>

            @if (Model.UpdatedAt != null)
            {
                <dt class="col-sm-3">Last Updated</dt>
                <dd class="col-sm-9">@Model.UpdatedAt</dd>
            }

        </dl>
    </section> *@

    <!-- ================= ACTIONS ================= -->
    <div class="mt-3">
        <button type="submit" class="btn btn-danger">
            Delete
        </button>

        <a asp-action="Index"
           class="btn btn-outline-secondary ms-2">
            Cancel
        </a>
    </div>

</form>