@model A_New_Hope.Models.ReferringOrganization

@{
    ViewData["Title"] = "Referring Organization Details";
}

<h1>Referring Organization Details</h1>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Name)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Name)</dd>

        <dt class="col-sm-3">Service Categories</dt>
        <dd class="col-sm-9">
            @if (Model.ReferringOrganizationServiceCategories != null &&
                        Model.ReferringOrganizationServiceCategories.Any())
            {
                @string.Join(", ",
                Model.ReferringOrganizationServiceCategories
                .Where(x => x.ServiceCategory != null)
                .Select(x => x.ServiceCategory.Name)
                .OrderBy(name => name))
                        }
            else
            {
                <span>—</span>
            }
        </dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.PhoneNumber)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.PhoneNumber)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Email)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Email)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.AddressLine1)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.AddressLine1)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.AddressLine2)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.AddressLine2)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.City)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.City)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.State)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.State)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.PostalCode)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.PostalCode)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.PrimaryContactName)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.PrimaryContactName)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Notes)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Notes)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.IsActive)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.IsActive)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.CreatedAt)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.CreatedAt)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.UpdatedAt)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.UpdatedAt)</dd>
    </dl>
</div>

<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary">Edit</a>
    <a asp-action="Index" class="btn btn-outline-secondary ms-1">Back to List</a>
</div>