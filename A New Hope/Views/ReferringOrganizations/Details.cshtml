@model A_New_Hope.Models.ReferringOrganization

@{
    ViewData["Title"] = "Referring Organization Details";
    var isEdit = ViewBag.IsEditMode as bool? ?? false;
}

<h1 class="mb-3">Referring Organization Details</h1>
<hr />

<form asp-action="Edit" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <!-- ================= BASIC INFO ================= -->
    <section class="mb-4">
        <h5 class="mb-3">Basic Information</h5>

        <dl class="row">

            <!-- NAME -->
            @if (!string.IsNullOrWhiteSpace(Model.Name) || isEdit)
            {
                <dt class="col-sm-3">Name</dt>
                <dd class="col-sm-9">
                    @if (isEdit)
                    {
                        <input asp-for="Name" class="form-control" />
                    }
                    else
                    {
                        @Model.Name
                    }
                </dd>
            }

            <!-- SERVICE CATEGORIES -->
            <dt class="col-sm-3">Service Categories</dt>
            <dd class="col-sm-9">
                @if (Model.ReferringOrganizationServiceCategories?.Any() == true)
                {
                    @string.Join(", ",
                        Model.ReferringOrganizationServiceCategories
                            .Where(x => x.ServiceCategory != null)
                            .Select(x => x.ServiceCategory.Name)
                            .OrderBy(x => x))
                }
                else
                {
                    <span class="text-muted">—</span>
                }
            </dd>

            <!-- PHONE -->
            @if (!string.IsNullOrWhiteSpace(Model.PhoneNumber) || isEdit)
            {
                <dt class="col-sm-3">Phone</dt>
                <dd class="col-sm-9">
                    @if (isEdit)
                    {
                        <input asp-for="PhoneNumber" class="form-control" />
                    }
                    else
                    {
                        @Model.PhoneNumber
                    }
                </dd>
            }

            <!-- EMAIL -->
            @if (!string.IsNullOrWhiteSpace(Model.Email) || isEdit)
            {
                <dt class="col-sm-3">Email</dt>
                <dd class="col-sm-9">
                    @if (isEdit)
                    {
                        <input asp-for="Email" class="form-control" />
                    }
                    else
                    {
                        @Model.Email
                    }
                </dd>
            }

        </dl>
    </section>

    <!-- ================= ADDRESS ================= -->
    @if (isEdit ||
         !string.IsNullOrWhiteSpace(Model.AddressLine1) ||
         !string.IsNullOrWhiteSpace(Model.AddressLine2) ||
         !string.IsNullOrWhiteSpace(Model.City) ||
         !string.IsNullOrWhiteSpace(Model.State) ||
         !string.IsNullOrWhiteSpace(Model.PostalCode))
    {
        <section class="mb-4">
            <h5 class="mb-3">Address</h5>

            <dl class="row">

                @if (!string.IsNullOrWhiteSpace(Model.AddressLine1) || isEdit)
                {
                    <dt class="col-sm-3">Address Line 1</dt>
                    <dd class="col-sm-9">
                        @if (isEdit)
                        {
                            <input asp-for="AddressLine1" class="form-control" />
                        }
                        else
                        {
                            @Model.AddressLine1
                        }
                    </dd>
                }

                @if (!string.IsNullOrWhiteSpace(Model.AddressLine2) || isEdit)
                {
                    <dt class="col-sm-3">Address Line 2</dt>
                    <dd class="col-sm-9">
                        @if (isEdit)
                        {
                            <input asp-for="AddressLine2" class="form-control" />
                        }
                        else
                        {
                            @Model.AddressLine2
                        }
                    </dd>
                }

                @if (!string.IsNullOrWhiteSpace(Model.City) || isEdit)
                {
                    <dt class="col-sm-3">City</dt>
                    <dd class="col-sm-9">
                        @if (isEdit)
                        {
                            <input asp-for="City" class="form-control" />
                        }
                        else
                        {
                            @Model.City
                        }
                    </dd>
                }

                @if (!string.IsNullOrWhiteSpace(Model.State) || isEdit)
                {
                    <dt class="col-sm-3">State</dt>
                    <dd class="col-sm-9">
                        @if (isEdit)
                        {
                            <input asp-for="State" class="form-control" maxlength="2" />
                        }
                        else
                        {
                            @Model.State
                        }
                    </dd>
                }

                @if (!string.IsNullOrWhiteSpace(Model.PostalCode) || isEdit)
                {
                    <dt class="col-sm-3">Postal Code</dt>
                    <dd class="col-sm-9">
                        @if (isEdit)
                        {
                            <input asp-for="PostalCode" class="form-control" />
                        }
                        else
                        {
                            @Model.PostalCode
                        }
                    </dd>
                }

            </dl>
        </section>
    }

    <!-- ================= CONTACT ================= -->
    @if (!string.IsNullOrWhiteSpace(Model.PrimaryContactName) || isEdit)
    {
        <section class="mb-4">
            <h5 class="mb-3">Primary Contact</h5>

            <dl class="row">

                <dt class="col-sm-3">Contact Name</dt>
                <dd class="col-sm-9">
                    @if (isEdit)
                    {
                        <input asp-for="PrimaryContactName" class="form-control" />
                    }
                    else
                    {
                        @Model.PrimaryContactName
                    }
                </dd>

            </dl>
        </section>
    }

    <!-- ================= NOTES ================= -->
    @if (!string.IsNullOrWhiteSpace(Model.Notes) || isEdit)
    {
        <section class="mb-4">
            <h5 class="mb-3">Notes</h5>

            @if (isEdit)
            {
                <textarea asp-for="Notes" class="form-control" rows="4"></textarea>
            }
            else
            {
                <div class="border rounded p-3">
                    @Model.Notes
                </div>
            }
        </section>
    }

    @* <!-- ================= SYSTEM ================= -->
    <section class="mb-4">
        <h5 class="mb-3">System Information</h5>

        <dl class="row">

            <dt class="col-sm-3">Active</dt>
            <dd class="col-sm-9">
                @if (isEdit)
                {
                    <input asp-for="IsActive" type="checkbox" class="form-check-input" />
                }
                else
                {
                    @Model.IsActive
                }
            </dd>

            @if (Model.CreatedAt != null)
            {
                <dt class="col-sm-3">Created</dt>
                <dd class="col-sm-9">@Model.CreatedAt</dd>
            }

            @if (Model.UpdatedAt != null)
            {
                <dt class="col-sm-3">Updated</dt>
                <dd class="col-sm-9">@Model.UpdatedAt</dd>
            }

        </dl>
    </section> *@

    <!-- ================= ACTIONS ================= -->
    <div class="mt-3">
        @if (isEdit)
        {
            <button type="submit" class="btn btn-secondary">Save</button>

            <a asp-action="Details"
               asp-route-id="@Model.Id"
               class="btn btn-outline-secondary ms-1">
                Cancel
            </a>
        }
        else
        {
            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-primary">
                Edit
            </a>

            <a asp-action="Index"
               class="btn btn-outline-secondary ms-1">
                Back to List
            </a>
        }
    </div>

</form>