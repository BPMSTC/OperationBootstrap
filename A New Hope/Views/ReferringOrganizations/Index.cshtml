@model IEnumerable<A_New_Hope.Models.ReferringOrganization>

@{
    ViewData["Title"] = "Referring Organizations";
}

<div class="page-header">
    <h1>Referring Organizations</h1>
</div>

<div class="mb-3 d-flex justify-content-between align-items-center">
    <a asp-action="Create" class="btn btn-primary">Create New</a>

    <form asp-action="Index" method="get" class="d-flex gap-2">
        <input type="text"
               name="searchTerm"
               value="@(ViewData["CurrentFilter"])"
               class="form-control w-auto"
               placeholder="Search organizations..." />

        <button type="submit" class="btn btn-outline-secondary">Search</button>

        <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
    </form>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>Organization Name</th>
                <th>Main Contact</th>
                <th>Point of Contact</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>

        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Name</td>

                        <td>@item.PrimaryContactName</td>

                        <td>
                            @{
                                var poc =
                                    !string.IsNullOrWhiteSpace(item.Email)
                                        ? item.Email
                                        : !string.IsNullOrWhiteSpace(item.PhoneNumber)
                                            ? item.PhoneNumber
                                            : "N/A";
                            }

                            @poc
                        </td>

                        <td class="text-end text-nowrap">
                            @* <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a> *@
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4" class="text-center text-muted">
                        No organizations found.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>