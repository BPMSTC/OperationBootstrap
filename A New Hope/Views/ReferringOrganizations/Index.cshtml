@model IEnumerable<A_New_Hope.Models.ReferringOrganization>

@{
    ViewData["Title"] = "Referring Organizations";

    var currentSearchTerm = ViewData["CurrentSearchTerm"] as string;
    var currentSortOrder = ViewData["CurrentSortOrder"] as string;

    string nextNameSort = string.IsNullOrWhiteSpace(currentSortOrder) || currentSortOrder == "name_asc"
        ? "name_desc"
        : "name_asc";

    string nextEmailSort = currentSortOrder == "email_asc"
        ? "email_desc"
        : "email_asc";

    string nameIndicator = currentSortOrder == "name_desc" ? "↓"
        : currentSortOrder == "name_asc" || string.IsNullOrWhiteSpace(currentSortOrder) ? "↑"
        : "";

    string emailIndicator = currentSortOrder == "email_asc" ? "↑"
        : currentSortOrder == "email_desc" ? "↓"
        : "";
}

<div class="page-header referrals-header d-flex justify-content-between align-items-center flex-wrap gap-3">
    <h1 class="mb-0">Referring Organizations</h1>

    <a asp-action="Create" class="btn btn-primary">
        Create New
    </a>
</div>

<div class="card shadow-sm mb-4 referrals-search-card">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-2 align-items-end">
            <div class="col-12 col-lg-8">
                <label for="searchTerm" class="form-label">Search organizations</label>
                <div class="input-group">
                    <span class="input-group-text" aria-hidden="true">🔍</span>
                    <input type="text"
                           id="searchTerm"
                           name="searchTerm"
                           value="@currentSearchTerm"
                           class="form-control"
                           placeholder="Search by organization name or email" />
                </div>
            </div>

            <div class="col-12 col-lg-4">
                <div class="d-flex gap-2 referrals-search-actions">
                    <button type="submit" class="btn btn-primary">
                        Search
                    </button>

                    <a asp-action="Index" class="btn btn-outline-secondary">
                        Reset
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle referrals-table">
        <thead>
            <tr>
                <th>
                    <a asp-action="Index"
                       asp-route-searchTerm="@currentSearchTerm"
                       asp-route-sortOrder="@nextNameSort"
                       class="sort-header-link">
                        <span>Organization Name</span>
                        @if (!string.IsNullOrWhiteSpace(nameIndicator))
                        {
                            <span class="sort-indicator">@nameIndicator</span>
                        }
                    </a>
                </th>

                <th>
                    <a asp-action="Index"
                       asp-route-searchTerm="@currentSearchTerm"
                       asp-route-sortOrder="@nextEmailSort"
                       class="sort-header-link">
                        <span>Email</span>
                        @if (!string.IsNullOrWhiteSpace(emailIndicator))
                        {
                            <span class="sort-indicator">@emailIndicator</span>
                        }
                    </a>
                </th>

                <th class="text-end text-nowrap">Actions</th>
            </tr>
        </thead>

        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <a asp-action="Details"
                               asp-route-id="@item.Id">
                                @item.Name
                            </a>
                        </td>

                        <td>
                            @if (!string.IsNullOrWhiteSpace(item.Email))
                            {
                                @item.Email
                            }
                            else
                            {
                                <span class="text-muted">N/A</span>
                            }
                        </td>

                        <td class="text-end text-nowrap">
                            <a asp-action="Edit"
                               asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-primary">
                                Edit
                            </a>

                            <a asp-action="Details"
                               asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-secondary">
                                Details
                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-danger">
                                Delete
                            </a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="3" class="text-center text-muted">
                        No organizations found.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>