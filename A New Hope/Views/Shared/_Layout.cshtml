@using Microsoft.AspNetCore.Identity
@using A_New_Hope.Models
@inject SignInManager<ApplicationUser> SignInManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - A_New_Hope</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-light border-bottom mb-3">
            <div class="container-fluid">

                <!-- LEFT: Logo Only -->
                <a class="navbar-brand d-flex align-items-center" href="/Home/Index">
                    <img src="~/images/logo_Operation-Bootstrap-tagline.svg"
                         alt="Operation Bootstrap Logo"
                         style="height:50px;" />
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar" aria-controls="mainNavbar"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <!-- RIGHT SIDE NAV -->
                        <ul class="navbar-nav ms-auto align-items-center">

                            <!-- Home -->
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/Home/Index">Home</a>
                            </li>

                            <!-- Staff Panel -->
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="StaffPanel" asp-action="Index">Staff Panel</a>
                            </li>

                            <!-- Admin Panel -->
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="AdminPanel" asp-action="Index">Admin Panel</a>
                                </li>
                            }

                            <!-- (OPTIONAL) Username - COMMENTED OUT -->
                            @*
                    <li class="nav-item me-2">
                        <span class="navbar-text text-muted" style="font-size:0.875rem;">
                            @User.Identity.Name
                        </span>
                    </li>
                    *@

                            <!-- Logout -->
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit"
                                            class="btn btn-sm btn-outline-danger fw-semibold">
                                        Sign Out
                                    </button>
                                </form>
                            </li>

                        </ul>
                    }
                    else
                    {
                        <!-- NOT LOGGED IN -->
                        <ul class="navbar-nav ms-auto">
                            <li class="nav-item">
                                <a class="btn btn-sm btn-outline-primary fw-semibold" href="/Account/Login">
                                    Sign In
                                </a>
                            </li>
                        </ul>
                    }

                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted mt-3">
        <div class="container">
            &copy; 2026 - A_New_Hope - <a asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @section Scripts {
        @{
            await Html.RenderPartialAsync("_ValidationScriptsPartial");
        }
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>