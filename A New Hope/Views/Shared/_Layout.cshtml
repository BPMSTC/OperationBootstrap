@using Microsoft.AspNetCore.Identity
@using A_New_Hope.Models
@inject SignInManager<ApplicationUser> SignInManager
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - A_New_Hope</title>

    <!-- Apply theme immediately to prevent flash -->
    <script>
            (function () {
                const theme = localStorage.getItem("theme");
                if (theme === "dark") {
                    document.documentElement.classList.add("dark-mode");
                }
            })();
    </script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav id="mainNavbarBar" class="navbar navbar-expand-sm navbar-light border-bottom mb-3">
            <div class="container-fluid">

                <!-- LEFT: Logo only -->
                <div class="d-flex align-items-center gap-2">
                    <a class="navbar-brand d-flex align-items-center" href="/Home/Index">
                        <img id="siteLogo"
                             src="/images/logo_Operation-Bootstrap-tagline.svg"
                             alt="Operation Bootstrap Logo"
                             style="height:50px;" />
                    </a>
                </div>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar" aria-controls="mainNavbar"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <ul class="navbar-nav ms-auto align-items-center">

                            <li class="nav-item">
                                <a class="nav-link" href="/Home/Index">Home</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" asp-controller="StaffPanel" asp-action="Index">Staff Panel</a>
                            </li>

                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="AdminPanel" asp-action="Index">Admin Panel</a>
                                </li>
                            }

                            <!-- Dark Mode Toggle (MOVED RIGHT) -->
                            <li class="nav-item me-2">
                                <button id="themeToggle" class="btn btn-sm btn-outline-secondary">
                                    <i id="themeIcon" class="bi bi-moon"></i>
                                </button>
                            </li>

                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit"
                                            class="btn btn-sm btn-outline-danger fw-semibold">
                                        Sign Out
                                    </button>
                                </form>
                            </li>

                        </ul>
                    }
                    else
                    {
                        <ul class="navbar-nav ms-auto align-items-center">

                            <!-- Also show toggle when logged out -->
                            <li class="nav-item me-2">
                                <button id="themeToggle" class="btn btn-sm btn-outline-secondary">
                                    <i id="themeIcon" class="bi bi-moon"></i>
                                </button>
                            </li>

                            <li class="nav-item">
                                <a class="btn btn-sm btn-outline-primary fw-semibold" href="/Account/Login">
                                    Sign In
                                </a>
                            </li>
                        </ul>
                    }

                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted mt-3">
        <div class="container">
            &copy; 2026 - A_New_Hope - <a asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script>
            const toggleBtn = document.getElementById("themeToggle");
            const icon = document.getElementById("themeIcon");
            const navbar = document.getElementById("mainNavbarBar");
            const logo = document.getElementById("siteLogo");

            function applyTheme(theme) {
                if (theme === "dark") {
                    document.documentElement.classList.add("dark-mode");

                    navbar.classList.remove("navbar-light", "bg-light");
                    navbar.classList.add("navbar-dark", "bg-dark");

                    icon.classList.remove("bi-moon");
                    icon.classList.add("bi-sun");

                    logo.src = "/images/logo_Operation-Bootstrap-tagline-Dark.svg";

                } else {
                    document.documentElement.classList.remove("dark-mode");

                    navbar.classList.remove("navbar-dark", "bg-dark");
                    navbar.classList.add("navbar-light", "bg-light");

                    icon.classList.remove("bi-sun");
                    icon.classList.add("bi-moon");

                    logo.src = "/images/logo_Operation-Bootstrap-tagline.svg";
                }
            }

            const savedTheme = localStorage.getItem("theme") || "light";
            applyTheme(savedTheme);

            toggleBtn.addEventListener("click", () => {
                const newTheme = document.documentElement.classList.contains("dark-mode")
                    ? "light"
                    : "dark";

                localStorage.setItem("theme", newTheme);
                applyTheme(newTheme);
            });
    </script>

    @await Html.PartialAsync("_ValidationScriptsPartial")
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>