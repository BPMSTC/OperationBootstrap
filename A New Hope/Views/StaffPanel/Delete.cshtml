@model A_New_Hope.Models.DomainUser

@{
    ViewData["Title"] = "Delete Staff";
}

<h1 class="mb-3">Delete Staff</h1>
<hr />

<form asp-action="Delete" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <!-- WARNING -->
    <p class="text-muted mb-4">
        This action will permanently delete this Staff member.
    </p>

    <!-- ================= ACCOUNT INFO ================= -->
    @if (Model.UserType != default || !string.IsNullOrWhiteSpace(Model.Email))
    {
        <section class="mb-4">
            <h5 class="mb-3">Account Information</h5>

            <dl class="row">

                @if (Model.UserType != default)
                {
                    <dt class="col-sm-3">User Type</dt>
                    <dd class="col-sm-9">@Model.UserType</dd>
                }

                @if (!string.IsNullOrWhiteSpace(Model.Email))
                {
                    <dt class="col-sm-3">Email</dt>
                    <dd class="col-sm-9">@Model.Email</dd>
                }

            </dl>
        </section>
    }

    <!-- ================= PERSONAL INFO ================= -->
    @if (!string.IsNullOrWhiteSpace(Model.FirstName) ||
         !string.IsNullOrWhiteSpace(Model.LastName) ||
         !string.IsNullOrWhiteSpace(Model.PhoneNumber))
    {
        <section class="mb-4">
            <h5 class="mb-3">Personal Information</h5>

            <dl class="row">

                @if (!string.IsNullOrWhiteSpace(Model.FirstName))
                {
                    <dt class="col-sm-3">First Name</dt>
                    <dd class="col-sm-9">@Model.FirstName</dd>
                }

                @if (!string.IsNullOrWhiteSpace(Model.LastName))
                {
                    <dt class="col-sm-3">Last Name</dt>
                    <dd class="col-sm-9">@Model.LastName</dd>
                }

                @if (!string.IsNullOrWhiteSpace(Model.PhoneNumber))
                {
                    <dt class="col-sm-3">Phone Number</dt>
                    <dd class="col-sm-9">@Model.PhoneNumber</dd>
                }

            </dl>
        </section>
    }

    <!-- ================= ADDRESS ================= -->
    @if (!string.IsNullOrWhiteSpace(Model.AddressLine1) ||
         !string.IsNullOrWhiteSpace(Model.AddressLine2) ||
         !string.IsNullOrWhiteSpace(Model.City) ||
         !string.IsNullOrWhiteSpace(Model.State) ||
         !string.IsNullOrWhiteSpace(Model.PostalCode))
    {
        <section class="mb-4">
            <h5 class="mb-3">Address</h5>

            <dl class="row">

                @if (!string.IsNullOrWhiteSpace(Model.AddressLine1))
                {
                    <dt class="col-sm-3">Address Line 1</dt>
                    <dd class="col-sm-9">@Model.AddressLine1</dd>
                }

                @if (!string.IsNullOrWhiteSpace(Model.AddressLine2))
                {
                    <dt class="col-sm-3">Address Line 2</dt>
                    <dd class="col-sm-9">@Model.AddressLine2</dd>
                }

                @if (!string.IsNullOrWhiteSpace(Model.City))
                {
                    <dt class="col-sm-3">City</dt>
                    <dd class="col-sm-9">@Model.City</dd>
                }

                @if (!string.IsNullOrWhiteSpace(Model.State))
                {
                    <dt class="col-sm-3">State</dt>
                    <dd class="col-sm-9">@Model.State</dd>
                }

                @if (!string.IsNullOrWhiteSpace(Model.PostalCode))
                {
                    <dt class="col-sm-3">Postal Code</dt>
                    <dd class="col-sm-9">@Model.PostalCode</dd>
                }

            </dl>
        </section>
    }

    <!-- ================= ACTIONS ================= -->
    <div class="mt-3">
        <button type="submit" class="btn btn-danger">
            Delete
        </button>

        <a asp-action="StaffListIndex"
           class="btn btn-outline-secondary ms-1">
            Cancel
        </a>
    </div>

</form>