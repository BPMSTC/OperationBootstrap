@{
    ViewData["Title"] = "Staff Panel";
}

<style>
    .staff-tile {
        transition: transform 0.15s ease, box-shadow 0.15s ease;
        border-radius: 12px;
        min-height: 140px;
    }

        .staff-tile:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 20px rgba(0,0,0,0.15);
        }

    .staff-icon {
        font-size: 2.5rem;
    }
</style>

<div class="container mt-4">

    <h2 class="text-center mb-4">Staff Panel</h2>

    <div class="row g-4 justify-content-center">

        <!-- Clients -->
        <div class="col-6 col-md-4 col-lg-3">
            <a asp-controller="ClientProfiles" asp-action="Index" class="text-decoration-none text-dark">
                <div class="card text-center p-4 staff-tile h-100">
                    <i class="bi bi-people staff-icon"></i>
                    <div class="mt-2 fw-semibold">Clients</div>
                </div>
            </a>
        </div>

        <!-- Household Members -->
        <div class="col-6 col-md-4 col-lg-3">
            <a asp-controller="HouseholdMembers" asp-action="Index" class="text-decoration-none text-dark">
                <div class="card text-center p-4 staff-tile h-100">
                    <i class="bi bi-person-lines-fill staff-icon"></i>
                    <div class="mt-2 fw-semibold">Household Members</div>
                </div>
            </a>
        </div>

        <!-- Inventory Items -->
        <div class="col-6 col-md-4 col-lg-3">
            <a asp-controller="InventoryItems" asp-action="Index" class="text-decoration-none text-dark">
                <div class="card text-center p-4 staff-tile h-100">
                    <i class="bi bi-box-seam staff-icon"></i>
                    <div class="mt-2 fw-semibold">Inventory Items</div>
                </div>
            </a>
        </div>

        <!-- Inventory Groups -->
        <div class="col-6 col-md-4 col-lg-3">
            <a asp-controller="InventoryChoiceGroups" asp-action="Index" class="text-decoration-none text-dark">
                <div class="card text-center p-4 staff-tile h-100">
                    <i class="bi bi-collection staff-icon"></i>
                    <div class="mt-2 fw-semibold">Inventory Groups</div>
                </div>
            </a>
        </div>

        <!-- Group Items -->
        <div class="col-6 col-md-4 col-lg-3">
            <a asp-controller="InventoryChoiceGroupItems" asp-action="Index" class="text-decoration-none text-dark">
                <div class="card text-center p-4 staff-tile h-100">
                    <i class="bi bi-list-ul staff-icon"></i>
                    <div class="mt-2 fw-semibold">Group Items</div>
                </div>
            </a>
        </div>

        <!-- Item Options -->
        <div class="col-6 col-md-4 col-lg-3">
            <a asp-controller="InventoryItemOptions" asp-action="Index" class="text-decoration-none text-dark">
                <div class="card text-center p-4 staff-tile h-100">
                    <i class="bi bi-sliders staff-icon"></i>
                    <div class="mt-2 fw-semibold">Item Options</div>
                </div>
            </a>
        </div>

        <!-- Referrals -->
        <div class="col-6 col-md-4 col-lg-3">
            <a asp-controller="Referrals" asp-action="Index" class="text-decoration-none text-dark">
                <div class="card text-center p-4 staff-tile h-100">
                    <i class="bi bi-arrow-left-right staff-icon"></i>
                    <div class="mt-2 fw-semibold">Referrals</div>
                </div>
            </a>
        </div>

        <!-- Organizations -->
        <div class="col-6 col-md-4 col-lg-3">
            <a asp-controller="ReferringOrganizations" asp-action="Index" class="text-decoration-none text-dark">
                <div class="card text-center p-4 staff-tile h-100">
                    <i class="bi bi-building staff-icon"></i>
                    <div class="mt-2 fw-semibold">Organizations</div>
                </div>
            </a>
        </div>

        <!-- Users -->
        <div class="col-6 col-md-4 col-lg-3">
            <a asp-controller="Users" asp-action="Index" class="text-decoration-none text-dark">
                <div class="card text-center p-4 staff-tile h-100">
                    <i class="bi bi-person staff-icon"></i>
                    <div class="mt-2 fw-semibold">Users</div>
                </div>
            </a>
        </div>


        <!-- Preferences -->
        <div class="col-6 col-md-4 col-lg-3">
            <a asp-controller="UserChoiceGroupPreferences" asp-action="Index" class="text-decoration-none text-dark">
                <div class="card text-center p-4 staff-tile h-100">
                    <i class="bi bi-gear staff-icon"></i>
                    <div class="mt-2 fw-semibold">Preferences</div>
                </div>
            </a>
        </div>

        <!-- Categories -->
        <div class="col-6 col-md-4 col-lg-3">
            <a asp-controller="Categories" asp-action="Index" class="text-decoration-none text-dark">
                <div class="card text-center p-4 staff-tile h-100">
                    <i class="bi bi-tags staff-icon"></i>
                    <div class="mt-2 fw-semibold">Categories</div>
                </div>
            </a>
        </div>

    </div>
</div>