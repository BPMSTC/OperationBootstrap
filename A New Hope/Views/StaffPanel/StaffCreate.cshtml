@model A_New_Hope.Models.ViewModels.StaffCreateViewModel

@{
    ViewData["Title"] = "Create Staff/Admin";
}

<div class="container py-4">
    <div class="row justify-content-center align-items-center" style="min-height: 70vh;">

        <div class="col-xl-6 col-lg-8">

            <div class="card wizard-card shadow-sm border-0">

                <div class="card-body p-4">

                    <!-- HEADER -->
                    <div class="mb-4 create-staff-header">
                        <h2 class="mb-1">Create Staff</h2>
                        <p class="mb-0 text-muted">
                            Enter basic account and contact details.
                        </p>
                    </div>

                    <form asp-action="StaffCreate" method="post" novalidate>
                        @Html.AntiForgeryToken()

                        <!-- VALIDATION -->
                        <div asp-validation-summary="ModelOnly"
                             class="alert validation-box mb-3">
                        </div>

                        <!-- USER TYPE -->
                        <div class="mb-3">
                            <label asp-for="UserType" class="form-label"></label>
                            <select asp-for="UserType" class="form-select">
                                <option value="">-- Select Type --</option>
                                <option value="Staff">Staff</option>
                                <option value="Admin">Admin</option>
                            </select>
                            <span asp-validation-for="UserType" class="text-danger"></span>
                        </div>

                        <!-- NAME -->
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="FirstName" class="form-label"></label>
                                <input asp-for="FirstName" class="form-control" />
                                <span asp-validation-for="FirstName" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="LastName" class="form-label"></label>
                                <input asp-for="LastName" class="form-control" />
                                <span asp-validation-for="LastName" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- EMAIL -->
                        <div class="mt-3">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <!-- PHONE -->
                        <div class="mt-3">
                            <label asp-for="PhoneNumber" class="form-label"></label>
                            <input asp-for="PhoneNumber" class="form-control" />
                            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                        </div>

                        <!-- ADDRESS (NOW MATCHES FORM STYLE) -->
                        <div class="mt-3">
                            <h5 class="mb-2">Address</h5>

                            <div class="mb-3">
                                <label asp-for="AddressLine1" class="form-label"></label>
                                <input asp-for="AddressLine1" class="form-control" />
                                <span asp-validation-for="AddressLine1" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="AddressLine2" class="form-label"></label>
                                <input asp-for="AddressLine2" class="form-control" />
                                <span asp-validation-for="AddressLine2" class="text-danger"></span>
                            </div>

                            <div class="row g-3">
                                <div class="col-md-5">
                                    <label asp-for="City" class="form-label"></label>
                                    <input asp-for="City" class="form-control" />
                                    <span asp-validation-for="City" class="text-danger"></span>
                                </div>

                                <div class="col-md-3">
                                    <label asp-for="State" class="form-label"></label>
                                    <input asp-for="State" class="form-control" maxlength="2" />
                                    <span asp-validation-for="State" class="text-danger"></span>
                                </div>

                                <div class="col-md-4">
                                    <label asp-for="PostalCode" class="form-label"></label>
                                    <input asp-for="PostalCode" class="form-control" />
                                    <span asp-validation-for="PostalCode" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <!-- PASSWORD -->
                        <div class="mt-3">
                            <label asp-for="Password" class="form-label"></label>
                            <input asp-for="Password" class="form-control" type="password" />

                            <div class="form-text text-muted">
                                Leave blank to use default password.
                            </div>

                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <!-- FOOTER -->
                        <div class="d-flex justify-content-between align-items-center pt-4 mt-2">

                            <a asp-controller="StaffPanel"
                                   asp-action="StaffListIndex"
                                   class="btn btn-secondary">
                                Cancel
                            </a>

                            <button type="submit" class="btn btn-primary px-4">
                                Next
                            </button>

                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>