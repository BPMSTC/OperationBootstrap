@model IEnumerable<A_New_Hope.Models.ViewModels.Users.DomainUserIndexRowViewModel>

@{
    ViewData["Title"] = "Users";
}

<div class="page-header">
    <h1>Staff & Admin</h1>
</div>

<div class="mb-3 d-flex justify-content-between align-items-center flex-wrap gap-2">

    <div class="d-flex align-items-center gap-2">
        <a asp-action="StaffCreate" class="btn btn-primary">Create New</a>
    </div>

    <form asp-action="StaffListIndex" method="get" class="d-flex gap-2">
        <input type="text"
               name="searchTerm"
               value="@(ViewData["CurrentFilter"])"
               class="form-control w-auto"
               placeholder="Search staff..." />

        <button type="submit" class="btn btn-outline-secondary">Search</button>
        <a asp-action="StaffListIndex" class="btn btn-outline-secondary">Clear</a>
    </form>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>First Name</th>
                <th>Last Name</th>
                <th>Point of Contact</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.FirstName</td>
                    <td>@item.LastName</td>

                    <td>
                        @if (!string.IsNullOrWhiteSpace(item.PhoneNumber))
                        {
                            <span>@item.PhoneNumber</span>
                        }
                        else if (!string.IsNullOrWhiteSpace(item.Email))
                        {
                            <span class="text-muted">@item.Email</span>
                        }
                        else
                        {
                            <span class="text-muted fst-italic">N/A</span>
                        }
                    </td>

                    <td class="text-end text-nowrap">

                        <!-- 🔥 SAME LOGIC AS USERS PAGE -->
                        @if (item.UserType == A_New_Hope.Models.UserType.Staff ||
                             item.UserType == A_New_Hope.Models.UserType.Admin)
                        {
                            @if (item.HasLoginAccount)
                            {
                                <a asp-controller="UserAccounts"
                                       asp-action="Manage"
                                       asp-route-domainUserId="@item.Id"
                                       class="btn btn-sm btn-outline-secondary">
                                    Manage Login
                                </a>
                            }
                            else
                            {
                                <a asp-controller="UserAccounts"
                                       asp-action="Create"
                                       asp-route-domainUserId="@item.Id"
                                       class="btn btn-sm btn-outline-primary">
                                    Create Login
                                </a>
                            }

                            <span> | </span>
                        }

                        <a asp-action="StaffDetails"
                               asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-secondary">
                            Details
                        </a>

                        <a asp-action="Delete"
                               asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-danger">
                            Delete
                        </a>

                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>