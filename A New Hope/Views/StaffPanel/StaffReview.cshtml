@model A_New_Hope.Models.ViewModels.StaffCreateViewModel

@{
    ViewData["Title"] = "Review Staff/Admin";
    var passwordDisplay = string.IsNullOrWhiteSpace(Model.Password)
        ? "Default will be used"
        : "Provided";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-xl-6 col-lg-8">

            <div class="card shadow-sm border-0">
                <div class="card-body p-4">

                    <div class="mb-4">
                        <h2 class="mb-1">Review</h2>
                        <p class="text-muted mb-0">
                            Confirm the information before creating the account.
                        </p>
                    </div>

                    <dl class="row mb-4">

                        <dt class="col-sm-4">User Type</dt>
                        <dd class="col-sm-8">@Model.UserType</dd>

                        <dt class="col-sm-4">First Name</dt>
                        <dd class="col-sm-8">@Model.FirstName</dd>

                        <dt class="col-sm-4">Last Name</dt>
                        <dd class="col-sm-8">@Model.LastName</dd>

                        <dt class="col-sm-4">Email</dt>
                        <dd class="col-sm-8">@Model.Email</dd>

                        <dt class="col-sm-4">Password</dt>
                        <dd class="col-sm-8">@passwordDisplay</dd>

                    </dl>

                    <form asp-action="ConfirmCreateStaff" method="post">
                        @Html.AntiForgeryToken()

                        <div class="d-flex justify-content-between">
                            <a asp-action="StaffCreate" class="btn btn-outline-secondary">Back</a>
                            <button type="submit" class="btn btn-success">
                                Confirm & Create
                            </button>
                        </div>
                    </form>

                </div>
            </div>

        </div>
    </div>
</div>