@model dynamic
@{
    ViewData["Title"] = "Manage Login";

    var domainUser = (A_New_Hope.Models.DomainUser)ViewBag.DomainUser;
    var identityUser = (A_New_Hope.Models.ApplicationUser)ViewBag.IdentityUser;
    var roles = (IEnumerable<string>)ViewBag.IdentityRoles;

    var isLockedOut = identityUser.LockoutEnd.HasValue
        && identityUser.LockoutEnd > DateTimeOffset.UtcNow;
}

<div class="section-header mb-3">
    <h1>Manage Login</h1>
</div>

<div class="container">

    <div class="card main-card">

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">

                <thead>
                    <tr>
                        <th style="width: 200px;">Field</th>
                        <th>Value</th>
                    </tr>
                </thead>

                <tbody>

                    <!-- NAME -->
                    <tr>
                        <td class="fw-semibold">Name</td>
                        <td>
                            @domainUser.LastName, @domainUser.FirstName
                        </td>
                    </tr>

                    <!-- DOMAIN EMAIL -->
                    <tr>
                        <td class="fw-semibold">Domain Email</td>
                        <td>
                            @domainUser.Email
                        </td>
                    </tr>

                    <!-- USER TYPE -->
                    <tr>
                        <td class="fw-semibold">User Type</td>
                        <td>
                            @domainUser.UserType
                        </td>
                    </tr>

                    <!-- DOMAIN STATUS -->
                    <tr>
                        <td class="fw-semibold">Domain Status</td>
                        <td>
                            @if (domainUser.IsActive)
                            {
                                <span class="text-success">Active</span>
                            }
                            else
                            {
                                <span class="text-secondary">Inactive</span>
                            }
                        </td>
                    </tr>

                    <!-- LOGIN STATUS -->
                    <tr>
                        <td class="fw-semibold">Login Status</td>
                        <td>
                            @if (isLockedOut)
                            {
                                <span class="text-danger">Disabled (Locked Out)</span>
                            }
                            else
                            {
                                <span class="text-success">Enabled</span>
                            }
                        </td>
                    </tr>

                </tbody>

            </table>
        </div>

        <!-- PASSWORD RESET BAR (NEW ADDITION) -->
        <div class="mt-3">

            <form asp-action="ResetPassword" method="post" class="d-flex gap-2 align-items-center flex-wrap">
                @Html.AntiForgeryToken()

                <input type="hidden" name="domainUserId" value="@domainUser.Id" />

                <input type="text"
                       name="newPassword"
                       class="form-control"
                       placeholder="Enter new temporary password (optional)"
                       style="max-width: 320px;" />

                <button type="submit" class="btn btn-warning">
                    Reset Password
                </button>

            </form>

        </div>

        <!-- ACTIONS -->
        <div class="mt-3 d-flex gap-2 flex-wrap align-items-center">

            @if (isLockedOut)
            {
                <form asp-action="EnableLogin" method="post" class="m-0">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="domainUserId" value="@domainUser.Id" />
                    <button type="submit" class="btn btn-success btn-sm">
                        Enable Login
                    </button>
                </form>
            }
            else
            {
                <form asp-action="DisableLogin" method="post" class="m-0">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="domainUserId" value="@domainUser.Id" />
                    <button type="submit" class="btn btn-danger btn-sm">
                        Disable Login
                    </button>
                </form>
            }

            <a asp-controller="StaffPanel"
                   asp-action="StaffListIndex"
                   class="btn btn-secondary btn-sm align-self-center">
                Back
            </a>

        </div>

    </div>
</div>