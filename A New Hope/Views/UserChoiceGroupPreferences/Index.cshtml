@model IEnumerable<A_New_Hope.Models.UserChoiceGroupPreference>

@{
    ViewData["Title"] = "User Choice Group Preferences";
}

<div class="page-header">
    <h1>User Choice Group Preferences</h1>
</div>

<div class="mb-3">
    <a asp-action="Create" class="btn btn-primary">Create New</a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>User</th>
                <th>Choice Group</th>
                <th>Selected Item</th>
                <th>Category</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @(
                            item.User != null
                            ? $"{item.User.LastName}, {item.User.FirstName}"
                            : ""
                        )
                    </td>
                    <td>
                        @(
                            item.InventoryChoiceGroup != null
                            ? (!string.IsNullOrWhiteSpace(item.InventoryChoiceGroup.DisplayLabel)
                            ? item.InventoryChoiceGroup.DisplayLabel
                            : item.InventoryChoiceGroup.Name)
                            : ""
                        )
                    </td>
                    <td>@(item.SelectedInventoryItem?.Name ?? "")</td>
                    <td>
                        @(
                            item.SelectedInventoryItem?.Category != null
                            ? (item.SelectedInventoryItem.Category.CategoryGroup != null
                            ? $"{item.SelectedInventoryItem.Category.CategoryGroup.Name} - {item.SelectedInventoryItem.Category.Name}"
                            : item.SelectedInventoryItem.Category.Name)
                            : ""
                        )
                    </td>
                    <td class="text-end text-nowrap">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>