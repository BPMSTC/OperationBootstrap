@model A_New_Hope.Models.UserItemPreference
@using System.Text.Json

@{
    ViewData["Title"] = "Edit";
    var inventoryItemOptionDataJson = JsonSerializer.Serialize(ViewBag.InventoryItemOptionData ?? new List<object>());
}

<h1>Edit</h1>

<h4>User Item Preference</h4>
<hr />
<div class="row">
    <div class="col-md-6 col-lg-5">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label asp-for="UserId" class="form-label"></label>
                <select asp-for="UserId" class="form-select" asp-items="ViewBag.UserId">
                    <option value="">-- Select User --</option>
                </select>
                <span asp-validation-for="UserId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="InventoryItemId" class="form-label"></label>
                <select asp-for="InventoryItemId" class="form-select" asp-items="ViewBag.InventoryItemId">
                    <option value="">-- Select Inventory Item --</option>
                </select>
                <span asp-validation-for="InventoryItemId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="InventoryItemOptionId" class="form-label"></label>
                <select asp-for="InventoryItemOptionId" class="form-select" asp-items="ViewBag.InventoryItemOptionId">
                    <option value="">-- No Option / Select Option --</option>
                </select>
                <span asp-validation-for="InventoryItemOptionId" class="text-danger"></span>
                <div class="form-text">
                    Select an option only when the inventory item has variants, such as Milk 1% or 2%.
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Preference" class="form-label"></label>
                <select asp-for="Preference" class="form-select" asp-items="ViewBag.PreferenceOptions">
                    <option value="">-- Select Preference --</option>
                </select>
                <span asp-validation-for="Preference" class="text-danger"></span>
            </div>

            <div class="mt-3 d-flex gap-2">
                <input type="submit" value="Save" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        const allInventoryItemOptions = @Html.Raw(inventoryItemOptionDataJson);

        const inventoryItemSelect = document.getElementById("InventoryItemId");
        const inventoryItemOptionSelect = document.getElementById("InventoryItemOptionId");

        function rebuildInventoryItemOptionDropdown() {
            const selectedInventoryItemId = inventoryItemSelect.value;
            const currentSelectedOptionId = inventoryItemOptionSelect.value;

            inventoryItemOptionSelect.innerHTML = "";

            const defaultOption = document.createElement("option");
            defaultOption.value = "";
            defaultOption.text = "-- No Option / Select Option --";
            inventoryItemOptionSelect.appendChild(defaultOption);

            if (!selectedInventoryItemId) {
                return;
            }

            const matchingOptions = allInventoryItemOptions.filter(o =>
                String(o.InventoryItemId) === String(selectedInventoryItemId));

            for (const option of matchingOptions) {
                const optionElement = document.createElement("option");
                optionElement.value = option.Id;
                optionElement.text = option.DisplayName;

                if (String(option.Id) === String(currentSelectedOptionId)) {
                    optionElement.selected = true;
                }

                inventoryItemOptionSelect.appendChild(optionElement);
            }
        }

        inventoryItemSelect.addEventListener("change", function () {
            inventoryItemOptionSelect.value = "";
            rebuildInventoryItemOptionDropdown();
        });

        rebuildInventoryItemOptionDropdown();
    </script>
}