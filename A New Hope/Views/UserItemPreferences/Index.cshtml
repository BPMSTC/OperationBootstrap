@model IEnumerable<A_New_Hope.Models.UserItemPreference>

@{
    ViewData["Title"] = "User Item Preferences";
}

<div class="page-header">
    <h1>User Item Preferences</h1>
</div>

<div class="mb-3">
    <a asp-action="Create" class="btn btn-primary">Create New</a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(model => model.Preference)</th>
                <th>User</th>
                <th>Inventory Item</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => item.Preference)</td>
                        <td>
                            @(item.User != null
                                ? (!string.IsNullOrWhiteSpace(item.User.Email)
                                ? item.User.Email
                                : $"{item.User.FirstName} {item.User.LastName}".Trim())
                            : "")
                        </td>
                        <td>
                            @(item.InventoryItem != null ? item.InventoryItem.Name : "")
                        </td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4" class="text-center text-muted">No user item preferences found.</td>
                </tr>
            }
        </tbody>
    </table>
</div>