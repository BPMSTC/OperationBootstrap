@model A_New_Hope.Models.ViewModels.Users.UserDetailsViewModel

<div class="alert alert-info">
    IsClient: @Model.IsClient <br />
    ClientProfile is null: @(Model.ClientProfile == null)
</div>

@{
    var heading = Model.User.UserType switch
    {
        A_New_Hope.Models.UserType.Admin => "Admin Details",
        A_New_Hope.Models.UserType.Staff => "Staff Details",
        A_New_Hope.Models.UserType.Client => "Client Details",
        _ => "User Details"
    };
    <div class="alert alert-info">
        <div><strong>DEBUG</strong></div>
        <div>IsClient: @Model.IsClient</div>
        <div>ClientProfile null: @(Model.ClientProfile == null)</div>
        <div>ClientIncomes null: @(Model.ClientIncomes == null)</div>
        <div>ClientIncomes count: @(Model.ClientIncomes?.Count ?? 0)</div>
        <div>Active incomes: @(Model.ClientIncomes?.Count(i => i.IsActive) ?? 0)</div>
    </div>

    var hideAddress =
        Model.IsClient &&
        Model.ClientProfile?.IsUnhoused == true;

    ViewData["Title"] = heading;
}

<h1 class="mb-3">@heading</h1>
<hr />

<!-- ================= BASIC INFO ================= -->
<section class="mb-4">
    <h5 class="mb-3">Basic Information</h5>

    <dl class="row">

        @if (!string.IsNullOrWhiteSpace(Model.User.FirstName) ||
             !string.IsNullOrWhiteSpace(Model.User.LastName))
        {
            <dt class="col-sm-3">Name</dt>
            <dd class="col-sm-9">
                @Model.User.FirstName @Model.User.LastName
            </dd>
        }

        @if (!string.IsNullOrWhiteSpace(Model.User.Email))
        {
            <dt class="col-sm-3">Email</dt>
            <dd class="col-sm-9">@Model.User.Email</dd>
        }

        @if (!string.IsNullOrWhiteSpace(Model.User.PhoneNumber))
        {
            <dt class="col-sm-3">Phone</dt>
            <dd class="col-sm-9">@Model.User.PhoneNumber</dd>
        }

        @if (Model.User.DateOfBirth != null)
        {
            <dt class="col-sm-3">Date of Birth</dt>
            <dd class="col-sm-9">
                @Model.User.DateOfBirth?.ToString("MM/dd/yyyy")
            </dd>
        }

    @*     @if (!hideAddress)
        {
            <dt class="col-sm-3">Address</dt>
            <dd class="col-sm-9">
                @Model.User.AddressLine1<br />

                @if (!string.IsNullOrWhiteSpace(Model.User.AddressLine2))
                {
                    @Model.User.AddressLine2
                    <br />
                }

                @(Model.User.City + ", " + Model.User.State + " " + Model.User.PostalCode)
            </dd>
        }
        else
        {
            <dt class="col-sm-3">Address</dt>
            <dd class="col-sm-9 text-muted">No fixed address</dd>
        }
    </dl> *@
</section>

    <!-- ================= ADDRESS ================= -->
    @if (!hideAddress)
    {
        <section class="mb-4">
            <h5 class="mb-3">Address</h5>

            <dl class="row mb-0">

                <dt class="col-sm-3">Address Line 1</dt>
                <dd class="col-sm-9">@Model.User.AddressLine1</dd>

                @if (!string.IsNullOrWhiteSpace(Model.User.AddressLine2))
                {
                    <dt class="col-sm-3">Address Line 2</dt>
                    <dd class="col-sm-9">@Model.User.AddressLine2</dd>
                }

                <dt class="col-sm-3">City</dt>
                <dd class="col-sm-9">@Model.User.City</dd>

                <dt class="col-sm-3">State</dt>
                <dd class="col-sm-9">@Model.User.State</dd>

                <dt class="col-sm-3">Postal Code</dt>
                <dd class="col-sm-9">@Model.User.PostalCode</dd>

            </dl>
        </section>
    }
    else
    {
        <section class="mb-4">
            <h5 class="mb-3">Address</h5>

            <div class="text-muted">
                No fixed address
            </div>
        </section>
    }

<!-- ================= FINANCIAL ================= -->
    <!-- ================= FINANCIAL ================= -->
    @if (Model.IsClient)
    {
        <section class="mb-4">
            <h5 class="mb-3">Financial Information</h5>

            <dl class="row">

                <!-- Employment Status -->
                <dt class="col-sm-3">Employment Status</dt>
                <dd class="col-sm-9">
                    @(Model.ClientProfile?.EmploymentStatus)
                </dd>

                <!-- Monthly Income Total -->
                <dt class="col-sm-3">Monthly Income</dt>
                <dd class="col-sm-9">
                    @{
                        var totalIncome = Model.ClientIncomes?
                            .Where(i => i.IsActive)
                            .Sum(i => i.MonthlyAmount);
                    }

                    @(totalIncome.HasValue
                        ? totalIncome.Value.ToString("C")
                        : "$0.00")
                </dd>

                <!-- Income Sources -->
                <dt class="col-sm-3">Income Sources</dt>
                <dd class="col-sm-9">

                    @if (Model.ClientIncomes?.Any(i => i.IsActive) == true)
                    {
                        <div class="d-flex flex-column gap-2">

                            @foreach (var income in Model.ClientIncomes
                                .Where(i => i.IsActive))
                            {
                                <div class="border rounded p-2 bg-surface">

                                    <div class="fw-semibold">
                                        @income.IncomeType
                                    </div>

                                    <div class="text-muted">
                                        @income.MonthlyAmount.ToString("C") / month
                                    </div>

                                </div>
                            }

                        </div>
                    }
                    else
                    {
                        <span class="text-muted">
                            No income records found.
                        </span>
                    }

                </dd>

            </dl>
        </section>
    }

<!-- ================= HOUSEHOLD ================= -->
@if (Model.IsClient && Model.HouseholdMembers?.Any() == true)
{
    <section class="mb-4">
        <div class="d-flex justify-content-between align-items-center">
            <h3 class="mb-0">Household Members</h3>

            <button id="toggleAllHouseholdMembers"
                    class="btn btn-outline-secondary btn-sm rounded-pill">
                Expand All
            </button>
        </div>

        <hr />

        @for (int i = 0; i < Model.HouseholdMembers.Count; i++)
        {
            var member = Model.HouseholdMembers[i];
            var collapseId = $"hh_{i}";

            var name = string.Join(" ",
                new[] { member.FirstName, member.LastName }
                .Where(x => !string.IsNullOrWhiteSpace(x)));

            if (string.IsNullOrWhiteSpace(name))
            {
                name = $"Household Member {i + 1}";
            }

            <div class="border rounded mb-2">
                <button class="btn w-100 text-start d-flex justify-content-between align-items-center"
                        data-bs-toggle="collapse"
                        data-bs-target="#@collapseId">
                    <span>@name</span>
                    <span>▾</span>
                </button>

                <div id="@collapseId" class="collapse p-3">
                    <dl class="row mb-0">
                        <dt class="col-sm-3">First Name</dt>
                        <dd class="col-sm-9">@member.FirstName</dd>

                        <dt class="col-sm-3">Last Name</dt>
                        <dd class="col-sm-9">@member.LastName</dd>

                        <dt class="col-sm-3">DOB</dt>
                        <dd class="col-sm-9">@member.DateOfBirth</dd>

                        <dt class="col-sm-3">Age</dt>
                        <dd class="col-sm-9">@member.ApproximateAge</dd>
                    </dl>
                </div>
            </div>
        }
    </section>
}

<!-- ================= REFERRALS ================= -->
@if (Model.IsClient)
{
    <section class="mb-4">
        <div class="d-flex justify-content-between align-items-center">
            <h3 id="referralsHeading" class="mb-0">Open Referrals</h3>

            <button id="toggleReferralsView"
                    class="btn btn-outline-secondary btn-sm rounded-pill">
                Show All
            </button>
        </div>

        <hr />

        @if (Model.Referrals?.Any() == true)
        {
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Status</th>
                            <th>Organization</th>
                            <th>Valid To</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var referral in Model.Referrals)
                        {
                            var isOpen =
                                referral.Status == A_New_Hope.Models.ReferralStatus.Approved &&
                                referral.ValidTo?.Date >= DateTime.Today;

                            <tr class="referral-row" data-open="@isOpen.ToString().ToLower()">
                                <td>@referral.ReferredOn.ToString("M/d/yyyy")</td>
                                <td>@referral.Status</td>
                                <td>@referral.ReferringOrganization?.Name</td>
                                <td>@referral.ValidTo?.ToString("M/d/yyyy")</td>
                                <td class="text-end">
                                    <a asp-action="Details"
                                           asp-controller="Referrals"
                                           asp-route-id="@referral.Id"
                                           class="btn btn-sm btn-outline-primary rounded-pill">
                                        View
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <p id="noOpenReferralsMessage" class="text-muted d-none mt-2">
                No open referrals found.
            </p>
        }
        else
        {
            <p class="text-muted">No referrals found.</p>
        }
    </section>
}

<!-- ================= ACTIONS ================= -->
<section class="mt-4">
    <a asp-action="Edit"
           asp-route-id="@Model.User.Id"
           class="btn btn-primary">
        Edit
    </a>

    @if (Model.User.UserType == A_New_Hope.Models.UserType.Client && Model.User.IsActive)
    {
        <a asp-controller="Referrals"
               asp-action="StartReferralEntryForClient"
               asp-route-id="@Model.User.Id"
               class="btn btn-outline-primary ms-2">
            Create Referral
        </a>
    }

    <a asp-action="Index" class="btn btn-outline-secondary ms-2">
        Back
    </a>
</section>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const toggleAllButton = document.getElementById("toggleAllHouseholdMembers");
        const collapses = document.querySelectorAll(".household-collapse");

        if (toggleAllButton && collapses.length > 0 && typeof bootstrap !== "undefined") {
            function areAllExpanded() {
                return Array.from(collapses).every(c => c.classList.contains("show"));
            }

            function updateToggleAllText() {
                toggleAllButton.textContent = areAllExpanded() ? "Collapse All" : "Expand All";
            }

            toggleAllButton.addEventListener("click", function () {
                const expand = !areAllExpanded();

                collapses.forEach(collapseElement => {
                    const collapseInstance =
                        bootstrap.Collapse.getInstance(collapseElement) ||
                        new bootstrap.Collapse(collapseElement, { toggle: false });

                    if (expand) {
                        collapseInstance.show();
                    } else {
                        collapseInstance.hide();
                    }
                });
            });

            collapses.forEach(collapseElement => {
                collapseElement.addEventListener("shown.bs.collapse", updateToggleAllText);
                collapseElement.addEventListener("hidden.bs.collapse", updateToggleAllText);
            });

            updateToggleAllText();
        }

        const referralsToggleButton = document.getElementById("toggleReferralsView");
        const referralsHeading = document.getElementById("referralsHeading");
        const referralRows = document.querySelectorAll(".referral-row");
        const noOpenReferralsMessage = document.getElementById("noOpenReferralsMessage");

        if (referralsToggleButton && referralsHeading && referralRows.length > 0) {
            let showingAllReferrals = false;

            function applyReferralFilter() {
                let visibleOpenCount = 0;

                referralRows.forEach(row => {
                    const isOpen = row.dataset.open === "true";

                    if (showingAllReferrals || isOpen) {
                        row.classList.remove("d-none");

                        if (isOpen) {
                            visibleOpenCount++;
                        }
                    } else {
                        row.classList.add("d-none");
                    }
                });

                referralsHeading.textContent = showingAllReferrals ? "All Referrals" : "Open Referrals";
                referralsToggleButton.textContent = showingAllReferrals ? "Show Open Referrals" : "Show All Referrals";

                if (noOpenReferralsMessage) {
                    if (!showingAllReferrals && visibleOpenCount === 0) {
                        noOpenReferralsMessage.classList.remove("d-none");
                    } else {
                        noOpenReferralsMessage.classList.add("d-none");
                    }
                }
            }

            referralsToggleButton.addEventListener("click", function () {
                showingAllReferrals = !showingAllReferrals;
                applyReferralFilter();
            });

            applyReferralFilter();
        }
    });
</script>