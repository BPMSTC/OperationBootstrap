@model A_New_Hope.Models.ViewModels.Users.UserDetailsViewModel

@{
    ViewData["Title"] = "User Details";
}

<h1>User Details</h1>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.User.Email)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.User.Email)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.User.PhoneNumber)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.User.PhoneNumber)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.User.FirstName)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.User.FirstName)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.User.LastName)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.User.LastName)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.User.AddressLine1)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.User.AddressLine1)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.User.AddressLine2)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.User.AddressLine2)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.User.City)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.User.City)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.User.State)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.User.State)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.User.PostalCode)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.User.PostalCode)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.User.DateOfBirth)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.User.DateOfBirth)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.User.DefaultPreference)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.User.DefaultPreference)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.User.UserType)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.User.UserType)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.User.IsActive)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.User.IsActive)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.User.CreatedAt)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.User.CreatedAt)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.User.UpdatedAt)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.User.UpdatedAt)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.User.DeletedAt)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.User.DeletedAt)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.User.CreatedByUser)</dt>
        <dd class="col-sm-9">
            @(Model.User.CreatedByUser != null ? Model.User.CreatedByUser.Id.ToString() : "")
        </dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.User.UpdatedByUser)</dt>
        <dd class="col-sm-9">
            @(Model.User.UpdatedByUser != null ? Model.User.UpdatedByUser.Id.ToString() : "")
        </dd>

        <dt class="col-sm-3">Login Account</dt>
        <dd class="col-sm-9">@(Model.HasLoginAccount ? "Yes" : "No")</dd>
    </dl>
</div>

@if (Model.IsClient)
{
    <div class="mt-4">
        <h3>Client Profile</h3>
        <hr />

        @if (Model.ClientProfile != null)
        {
            <dl class="row">
                <dt class="col-sm-3">Employment Status</dt>
                <dd class="col-sm-9">@Model.ClientProfile.EmploymentStatus</dd>

                <dt class="col-sm-3">Monthly Earned Income</dt>
                <dd class="col-sm-9">
                    @(Model.ClientProfile.EarnedIncomeMonthly.HasValue
                                ? Model.ClientProfile.EarnedIncomeMonthly.Value.ToString("C")
                                : "")
                </dd>

                <dt class="col-sm-3">Unhoused</dt>
                <dd class="col-sm-9">@(Model.ClientProfile.IsUnhoused ? "Yes" : "No")</dd>
            </dl>
        }
        else
        {
            <p class="text-muted">No client profile found.</p>
        }
    </div>

    <div class="mt-4">
        <h3>Household Members</h3>
        <hr />

        @if (Model.HouseholdMembers != null && Model.HouseholdMembers.Any())
        {
            @for (int i = 0; i < Model.HouseholdMembers.Count; i++)
            {
                var member = Model.HouseholdMembers[i];

                <div class="card wizard-card shadow-sm border-0 mb-3">
                    <div class="card-body">
                        <h5 class="card-title">Household Member @(i + 1)</h5>

                        <dl class="row mb-0">
                            <dt class="col-sm-3">First Name</dt>
                            <dd class="col-sm-9">@member.FirstName</dd>

                            <dt class="col-sm-3">Last Name</dt>
                            <dd class="col-sm-9">@member.LastName</dd>

                            <dt class="col-sm-3">Date of Birth</dt>
                            <dd class="col-sm-9">@member.DateOfBirth</dd>

                            <dt class="col-sm-3">Age As Of Date</dt>
                            <dd class="col-sm-9">@member.AgeAsOfDate</dd>
                        </dl>
                    </div>
                </div>
            }
        }
        else
        {
            <p class="text-muted">No household members found.</p>
        }
    </div>
}

<div>
    <a asp-action="Edit" asp-route-id="@Model.User.Id" class="btn btn-primary">Edit</a>

    @if (Model.User.UserType == A_New_Hope.Models.UserType.Client && Model.User.IsActive && Model.User.DeletedAt == null)
    {
        <a asp-controller="Referrals"
           asp-action="StartReferralEntryForClient"
           asp-route-id="@Model.User.Id"
           class="btn btn-outline-primary rounded-pill ms-1">
            Create Referral
        </a>
    }

    <a asp-action="Index" class="btn btn-outline-secondary ms-1">Back to List</a>
</div>