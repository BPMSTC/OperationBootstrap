@model A_New_Hope.Models.DomainUser

@{
    var incomes = ViewBag.Incomes as List<UserIncomeInput>
              ?? new List<UserIncomeInput>();

    var members = ViewBag.HouseholdMembers as List<A_New_Hope.Models.HouseholdMember>
                  ?? new List<A_New_Hope.Models.HouseholdMember>();
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-xl-9 col-lg-10">

            <div class="card wizard-card shadow-sm border-0">
                <div class="card-body p-4">

                    <div class="mb-4">
                        <h2 class="mb-1">Review User Setup</h2>
                        <p class="text-muted mb-0">
                            Review all entered information before finalizing.
                        </p>
                    </div>

                    <!-- ================= USER INFO ================= -->
                    <div class="card wizard-card shadow-sm border-0 mb-4">
                        <div class="card-body">

                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <h5 class="card-title mb-0">User Information</h5>
                                <a asp-action="CreateWizard"
                                       class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                                    Edit
                                </a>
                            </div>

                            <dl class="row mb-0">

                                @if (!string.IsNullOrWhiteSpace(Model.FirstName))
                                {
                                    <dt class="col-sm-4">First Name</dt>
                                    <dd class="col-sm-8">@Model.FirstName</dd>
                                }

                                @if (!string.IsNullOrWhiteSpace(Model.LastName))
                                {
                                    <dt class="col-sm-4">Last Name</dt>
                                    <dd class="col-sm-8">@Model.LastName</dd>
                                }

                                @if (!string.IsNullOrWhiteSpace(Model.Email))
                                {
                                    <dt class="col-sm-4">Email</dt>
                                    <dd class="col-sm-8">@Model.Email</dd>
                                }

                                @if (!string.IsNullOrWhiteSpace(Model.PhoneNumber))
                                {
                                    <dt class="col-sm-4">Phone Number</dt>
                                    <dd class="col-sm-8">@Model.PhoneNumber</dd>
                                }

                                @if (!string.IsNullOrWhiteSpace(Model.AddressLine1))
                                {
                                    <dt class="col-sm-4">Address</dt>
                                    <dd class="col-sm-8">
                                        @Model.AddressLine1
                                        @if (!string.IsNullOrWhiteSpace(Model.AddressLine2))
                                        {
                                            <br />
                                            @Model.AddressLine2
                                        }
                                    </dd>
                                }

                                @if (!string.IsNullOrWhiteSpace(Model.City) ||
                                     !string.IsNullOrWhiteSpace(Model.State) ||
                                     !string.IsNullOrWhiteSpace(Model.PostalCode))
                                {
                                    <dt class="col-sm-4">Location</dt>
                                    <dd class="col-sm-8">
                                        @Model.City
                                        @if (!string.IsNullOrWhiteSpace(Model.City) &&
                                             !string.IsNullOrWhiteSpace(Model.State))
                                        {
                                            <text>, </text>
                                        }
                                        @Model.State
                                        @if (!string.IsNullOrWhiteSpace(Model.PostalCode))
                                        {
                                            <text> </text>
                                            @Model.PostalCode
                                        }
                                    </dd>
                                }

                                @if (Model.DateOfBirth != null)
                                {
                                    <dt class="col-sm-4">Date of Birth</dt>
                                    <dd class="col-sm-8">
                                        @Model.DateOfBirth?.ToString("MM/dd/yyyy")
                                    </dd>
                                }

                                @if (Model.ClientProfile != null)
                                {
                                    <dt class="col-sm-4">Employment Status</dt>
                                    <dd class="col-sm-8">
                                        @Model.ClientProfile.EmploymentStatus
                                    </dd>
                                }

                                @if (Model.UserType != null)
                                {
                                    <dt class="col-sm-4">User Type</dt>
                                    <dd class="col-sm-8">@Model.UserType</dd>
                                }

                            </dl>

                        </div>
                    </div>

                    <!-- ================= HOUSEHOLD ================= -->
                    @for (int i = 0; i < members.Count; i++)
{
    var m = members[i];

    <div class="border rounded p-3 mb-3">
        <div class="mb-2 fw-semibold">
            Household Member @(i + 1)
        </div>

        <dl class="row mb-0">

            <dt class="col-sm-4">First Name</dt>
            <dd class="col-sm-8">@m.FirstName</dd>

            <dt class="col-sm-4">Last Name</dt>
            <dd class="col-sm-8">@m.LastName</dd>

            @if (m.DateOfBirth.HasValue)
            {
                <dt class="col-sm-4">Date of Birth</dt>
                <dd class="col-sm-8">@m.DateOfBirth?.ToString("MM/dd/yyyy")</dd>
            }

            @if (m.ApproximateAge.HasValue)
            {
                <dt class="col-sm-4">Age</dt>
                <dd class="col-sm-8">@m.ApproximateAge</dd>
            }

        </dl>
    </div>
}

                    <!-- ================= INCOME ================= -->
                    @if (incomes?.Any() == true)
                    {
                        <div class="card wizard-card shadow-sm border-0 mb-4">
                            <div class="card-body">

                                <div class="d-flex justify-content-between align-items-start mb-3">
                                    <h5 class="card-title mb-0">Income</h5>

                                    <a asp-action="CreateWizard"
                                           class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                                        Edit
                                    </a>
                                </div>

                                @foreach (var inc in incomes)
                                {
                                    <div class="border rounded p-3 mb-3">
                                        <dl class="row mb-0">
                                            <dt class="col-sm-4">Income Type</dt>
                                            <dd class="col-sm-8">@inc.IncomeType</dd>

                                            <dt class="col-sm-4">Monthly Amount</dt>
                                            <dd class="col-sm-8">
                                                @((inc.MonthlyAmount ?? 0).ToString("C"))
                                            </dd>
                                        </dl>
                                    </div>
                                }

                            </div>
                        </div>
                    }

                    <!-- ================= FINAL FORM ================= -->
                    <form asp-action="FinalizeConfirm" method="post">
                        @Html.AntiForgeryToken()

                        <div class="d-flex justify-content-between align-items-stretch pt-2">

                            <a asp-action="HouseholdMembers"
                                   class="btn btn-outline-secondary d-flex align-items-center">
                                Back
                            </a>

                            <button type="submit"
                                    class="btn btn-primary">
                                Confirm User
                            </button>

                        </div>
                    </form>

                </div>
            </div>

        </div>
    </div>
</div>


