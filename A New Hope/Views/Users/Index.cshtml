@model IEnumerable<A_New_Hope.Models.ViewModels.Users.DomainUserIndexRowViewModel>

@{
    ViewData["Title"] = "Users";
}

<div class="page-header">
    <h1>
        @(User.Identity?.IsAuthenticated == true && User.IsInRole("Admin")
            ? "Clients"
            : "Clients")
    </h1>
</div>

<div class="mb-3 d-flex justify-content-between align-items-center flex-wrap gap-2">

    <!-- LEFT: Create + Filter -->
    <div class="d-flex align-items-center gap-2">
        <a asp-action="CreateWizard" class="btn btn-primary">Create New</a>

        @* @if (User.IsInRole("Admin"))
        {
            <div class="d-flex align-items-center gap-1 ms-2">
                <small class="text-muted me-1">View:</small>

                <div class="btn-group btn-group-sm" role="group">
                    <a asp-action="Index" asp-route-filter="all"
                           class="btn @(ViewData["UserFilter"]?.ToString() == "clients" || ViewData["UserFilter"]?.ToString() == "staff"
                                                                           ? "btn-outline-secondary"
                                                                           : "btn-secondary")">
                        All
                    </a>

                    <a asp-action="Index" asp-route-filter="clients"
                           class="btn @(ViewData["UserFilter"]?.ToString() == "clients"
                                                                           ? "btn-secondary"
                                                                           : "btn-outline-secondary")">
                        Clients
                    </a>

                    <a asp-action="Index" asp-route-filter="staff"
                           class="btn @(ViewData["UserFilter"]?.ToString() == "staff"
                                                                           ? "btn-secondary"
                                                                           : "btn-outline-secondary")">
                        Staff
                    </a>
                </div>
            </div>
        } *@
    </div>

    <!-- RIGHT: Search -->
    <form asp-action="Index" method="get" class="d-flex gap-2">
        <input type="hidden" name="filter" value="@ViewData["UserFilter"]" />

        <input type="text"
               name="searchTerm"
               value="@(ViewData["CurrentFilter"])"
               class="form-control w-auto"
               placeholder="Search Clients..." />

        <button type="submit" class="btn btn-outline-secondary">Search</button>

        <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
    </form>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>First Name</th>
                <th>Last Name</th>
                <th>Point of Contact</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                // Hide Admin + Staff unless current user is Admin
                // ALWAYS hide Admin + Staff
                if (item.UserType == A_New_Hope.Models.UserType.Admin ||
                    item.UserType == A_New_Hope.Models.UserType.Staff)
                {
                    continue;
                }

                var pointOfContact =
                    !string.IsNullOrWhiteSpace(item.PhoneNumber) ? item.PhoneNumber :
                    !string.IsNullOrWhiteSpace(item.Email) ? item.Email :
                    "N/A";

                <tr>
                    <td>@item.FirstName</td>
                    <td>@item.LastName</td>
                    <td>
                        @if (!string.IsNullOrWhiteSpace(item.PhoneNumber))
                        {
                            <span>@item.PhoneNumber</span>
                        }
                        else if (!string.IsNullOrWhiteSpace(item.Email))
                        {
                            <span class="text-muted">@item.Email</span>
                        }
                        else
                        {
                            <span class="text-muted fst-italic">N/A</span>
                        }
                    </td>

                    <td class="text-end text-nowrap">

                        @if (item.UserType == A_New_Hope.Models.UserType.Staff || item.UserType == A_New_Hope.Models.UserType.Admin)
                        {
                            @if (item.HasLoginAccount)
                            {
                                <a asp-controller="UserAccounts"
                                   asp-action="Manage"
                                   asp-route-domainUserId="@item.Id"
                                   class="btn btn-sm btn-outline-secondary">Manage Login</a>
                            }
                            else
                            {
                                <a asp-controller="UserAccounts"
                                       asp-action="Create"
                                       asp-route-domainUserId="@item.Id"
                                       class="btn btn-sm btn-outline-primary">
                                    Create Login
                                </a>
                            }

                            <span> | </span>
                        }

                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>

                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>