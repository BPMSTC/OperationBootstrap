@model IEnumerable<A_New_Hope.Models.ViewModels.DomainUserIndexRowViewModel>

@{
    ViewData["Title"] = "Users";
}

<div class="page-header">
    <h1>Users</h1>
</div>

<div class="mb-3">
    <a asp-action="Create" class="btn btn-primary">Create New</a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>Email</th>
                <th>Name</th>
                <th>@Html.DisplayNameFor(model => model.PhoneNumber)</th>
                <th>@Html.DisplayNameFor(model => model.City)</th>
                @* <th>@Html.DisplayNameFor(model => model.State)</th>
                <th>@Html.DisplayNameFor(model => model.PostalCode)</th> *@
                @* <th>@Html.DisplayNameFor(model => model.DateOfBirth)</th> *@
                <th>@Html.DisplayNameFor(model => model.DefaultPreference)</th>
                @* <th>@Html.DisplayNameFor(model => model.UserType)</th> *@
                @* <th>Has Login</th> *@
                <th>@Html.DisplayNameFor(model => model.IsActive)</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.Email)</td>
                    <td>@($"{item.LastName}, {item.FirstName}")</td>
                    <td>@Html.DisplayFor(modelItem => item.PhoneNumber)</td>
                    <td>@Html.DisplayFor(modelItem => item.City)</td>
                    @* <td>@Html.DisplayFor(modelItem => item.State)</td>
                    <td>@Html.DisplayFor(modelItem => item.PostalCode)</td> *@
                    @* <td>@Html.DisplayFor(modelItem => item.DateOfBirth)</td> *@
                    <td>@Html.DisplayFor(modelItem => item.DefaultPreference)</td>
                    @* <td>@Html.DisplayFor(modelItem => item.UserType)</td> *@
                    @* <td>
                        @if (item.UserType == A_New_Hope.Models.UserType.Staff || item.UserType == A_New_Hope.Models.UserType.Admin)
                        {
                            @(item.HasLoginAccount ? "Yes" : "No")
                        }
                        else
                        {
                            <span class="text-muted">N/A</span>
                        }
                    </td> *@
                    <td>@Html.DisplayFor(modelItem => item.IsActive)</td>
                    <td class="text-end text-nowrap">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                        @if (item.UserType == A_New_Hope.Models.UserType.Staff || item.UserType == A_New_Hope.Models.UserType.Admin)
                        {
                            <span> | </span>
                            @if (item.HasLoginAccount)
                            {
                                <a asp-controller="UserAccounts" asp-action="Manage" asp-route-domainUserId="@item.Id" class="btn btn-sm btn-outline-secondary">Manage Login</a>
                            }
                            else
                            {
                                <a asp-controller="UserAccounts" asp-action="Create" asp-route-domainUserId="@item.Id" class="btn btn-sm btn-outline-primary">Create Login</a>
                            }
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>