{
    // Logging configuration for ASP.NET Core.
    // These levels control what gets written by ILogger<T> across the app.
    "Logging": {
        "LogLevel": {
            // Default log level for everything that doesn't have a more specific category rule.
            // "Information" will include: Information, Warning, Error, Critical (but not Debug/Trace).
            "Default": "Information",

            // Framework logs can be noisy; setting this to "Warning" keeps the console cleaner.
            // Raise to "Information" temporarily if you need deeper diagnostics (routing/auth/middleware).
            "Microsoft.AspNetCore": "Warning",

            // Controls the hosting lifetime messages like "Now listening on..." and shutdown notices.
            // Keeping this at "Information" is useful during development.
            "Microsoft.Hosting.Lifetime": "Information"
        }
    },

    // Serilog configuration (file logging).
    // Note: This is used once you wire Serilog in Program.cs via builder.Host.UseSerilog(...)
    "Serilog": {
        "Using": [ "Serilog.Sinks.File" ],
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Warning",
                "Microsoft.AspNetCore": "Warning",
                "Microsoft.Hosting.Lifetime": "Information",
                "System": "Warning"
            }
        },
        "WriteTo": [
            {
                "Name": "File",
                "Args": {
                    "path": "Logs/log-.txt",
                    "rollingInterval": "Day",
                    "retainedFileCountLimit": 14,
                    "shared": true,
                    "flushToDiskInterval": "00:00:02",
                    "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {SourceContext} {Message:lj} {Properties:j}{NewLine}{Exception}"
                }
            }
        ],
        "Enrich": [ "FromLogContext" ]
    },

    // Host filtering for requests. "*" allows any host header.
    // In production, you typically restrict this to known hostnames (defense-in-depth).
    "AllowedHosts": "*",

    "ConnectionStrings": {
        // Primary EF Core connection string used by ApplicationDbContext.
        // This is currently configured for local MySQL:
        // - server=localhost
        // - port=3306 (default MySQL port)
        // - database=anewhope_db
        // - user=root / password=root (dev only; do not use in production)
        //
        // Tip: Many teams override this in appsettings.Development.json or environment variables
        // so secrets aren't committed to source control.
        "DefaultConnection": "server=localhost;port=3306;database=anewhope_db;user=root;password=root;"
    }
}